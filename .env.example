# Copy to .env and fill in. compose refuses to start without the required ones,
# which is better than starting with a password somebody read in a git repo.

# Required: the Postgres password. Any long random string; nothing else reads it.
POSTGRES_PASSWORD=

# Required: your identity provider. Auth is OIDC-only.
GATHERUM_OIDC_AUTHORITY=https://auth.example.org
GATHERUM_OIDC_CLIENT_ID=gatherum
GATHERUM_OIDC_CLIENT_SECRET=

# Where the knowledge base lives on the host. This directory is the system of
# record — back up this, and everything survives losing the database. It is the
# only thing on the host the container needs to write.
#
GATHERUM_DATA=./data

# The user the container runs as, which must own GATHERUM_DATA. Plain Docker: leave
# these alone and hand the directory to the image's own user:
#
#     mkdir -p data && sudo chown -R 1654:1654 data
#
# TrueNAS SCALE: its apps run as 568:568 and its datasets are already owned that way,
# so point GATHERUM_DATA at the dataset and set both of these to 568 instead of
# chowning anything.
#
#     GATHERUM_UID=568
#     GATHERUM_GID=568
#
# Unsure? `stat -c %u:%g /path/to/your/data/dir` is the answer.
GATHERUM_UID=1654
GATHERUM_GID=1654

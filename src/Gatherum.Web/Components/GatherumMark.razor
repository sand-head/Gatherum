@* The Gatherum mark: a node with its three linked neighbors, in the four
   brand hues. Inline SVG so it inherits tokens and needs no asset fetch. *@
<svg class="mark" width="@Size" height="@Size" viewBox="0 0 24 24" aria-hidden="true">
    <g stroke="var(--outline)" stroke-width="1.5">
        <path d="M12 12 5.2 6.8M12 12l6.8-5.2M12 12v7.6" fill="none" />
    </g>
    <circle cx="12" cy="12" r="3.4" fill="var(--g-blue)" />
    <circle cx="5.2" cy="6.8" r="2.5" fill="var(--g-red)" />
    <circle cx="18.8" cy="6.8" r="2.5" fill="var(--g-yellow)" />
    <circle cx="12" cy="19.6" r="2.5" fill="var(--g-green)" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 24;
}

@inherits GatherumComponent
@implements IDisposable
@inject AppOperations Ops
@inject PresenceTracker Presence
@using Gatherum.Web.Services
@using SlopEdit.Blazor
@using SlopEdit.Core.Document
@using SlopEdit.Core.Highlighting

<div class="editor-pane">
    <div class="editor-toolbar">
        <span class="presence">
            @foreach (var editor in othersEditing)
            {
                <span class="presence-chip">@editor is editing</span>
            }
        </span>
        @if (staleWarning)
        {
            <span class="stale-warning">Someone saved a newer version — your next save
                makes a new one; theirs stays in history.</span>
        }
        <button class="ghost" @onclick="OpenMentionDialog">Link node…</button>
        @if (IsMarkdown)
        {
            <button class="ghost" @onclick="TogglePreview">@(showPreview ? "Hide preview" : "Preview")</button>
        }
        <span class="save-indicator">@saveLabel</span>
    </div>

    <div class="editor-split @(showPreview ? "with-preview" : "")">
        <div class="editor-surface">
            @if (document is not null)
            {
                <EditorView Grid="document" OnChange="OnChanged" AriaLabel="Document editor" />
            }
        </div>
        @if (showPreview)
        {
            <div class="editor-preview page-content">
                @((MarkupString)previewHtml)
            </div>
        }
    </div>

    @if (mentionOpen)
    {
        <div class="mention-dialog">
            <input placeholder="Search nodes…" value="@mentionQuery"
                   @oninput="OnMentionQuery" @onkeydown="OnMentionKey" autofocus />
            <div class="mention-results">
                @foreach (var result in mentionResults)
                {
                    <button @onclick="() => InsertMention(result)">
                        <span class="kind">@result.Kind</span> @result.Title
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid NodeId { get; set; }
    [Parameter, EditorRequired] public string FileName { get; set; } = "";
    [Parameter, EditorRequired] public string MediaType { get; set; } = "";

    private EditorDocument? document;
    private string saveLabel = "";
    private bool showPreview;
    private string previewHtml = "";
    private bool staleWarning;
    private int lastKnownHead;
    private IReadOnlyList<string> othersEditing = [];
    private System.Threading.Timer? saveTimer;
    private System.Threading.Timer? presenceTimer;

    private bool IsMarkdown => MediaType == Gatherum.Core.Domain.MediaTypes.Markdown;

    private bool mentionOpen;
    private string mentionQuery = "";
    private List<SearchResult> mentionResults = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        lastKnownHead = await Ops.Files(s => s.GetHeadVersionAsync(UserId, NodeId));
        var text = await Ops.Files(s => s.GetTextAsync(UserId, NodeId));
        document = new EditorDocument(text) { Lexer = LexerRegistry.ForPath(FileName) };
        presenceTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(HeartbeatAsync), null, 0, 5000);
    }

    private void OnChanged(string changedText)
    {
        saveLabel = "Saving…";
        saveTimer?.Dispose();
        saveTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(SaveAsync), null, 1200, Timeout.Infinite);
        if (showPreview)
            previewHtml = MarkdownRender.ToHtml(document!.Text);
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (document is null)
            return;
        var version = await Ops.Files(s => s.SaveTextAsync(UserId, NodeId, document.Text));
        lastKnownHead = version.Number;
        staleWarning = false;
        saveLabel = "Saved";
        StateHasChanged();
    }

    private async Task HeartbeatAsync()
    {
        Presence.Heartbeat(NodeId, UserId, UserName);
        othersEditing = Presence.OthersEditing(NodeId, UserId);
        var head = await Ops.Files(s => s.GetHeadVersionAsync(UserId, NodeId));
        if (head > lastKnownHead)
            staleWarning = true;
        StateHasChanged();
    }

    private void TogglePreview()
    {
        showPreview = !showPreview;
        if (showPreview && document is not null)
            previewHtml = MarkdownRender.ToHtml(document.Text);
    }

    private void OpenMentionDialog()
    {
        mentionOpen = true;
        mentionQuery = "";
        mentionResults = [];
    }

    private async Task OnMentionQuery(ChangeEventArgs e)
    {
        mentionQuery = e.Value?.ToString() ?? "";
        mentionResults = mentionQuery.Length == 0
            ? []
            : await Ops.Search(s => s.SearchAsync(UserId, mentionQuery, limit: 8));
    }

    private void OnMentionKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            mentionOpen = false;
    }

    private void InsertMention(SearchResult hit)
    {
        document?.Insert($"[@{hit.Title}](node://{hit.Id})");
        mentionOpen = false;
        OnChanged("");
    }

    public void Dispose()
    {
        saveTimer?.Dispose();
        presenceTimer?.Dispose();
        Presence.Leave(NodeId, UserId);
    }
}

@page "/categories"
@inherits GatherumComponent
@inject AppOperations Ops
@using Gatherum.Core.Services
@using Gatherum.Client

<PageTitle>Categories — Gatherum</PageTitle>

<h1>Categories</h1>
<p class="hint">
    What the wiki is about, arranged. Every category is a page of its own, and a category
    filed under another is a subcategory — which is why one subject can sit in two places
    here, the way an index does.
</p>

<ul class="category-tree">
    @foreach (var row in outline)
    {
        <li style="--depth: @row.Depth">
            <a href="@CategoryUrl.Page(row.Category.Name)">@row.Category.Name</a>
            <span class="count">@row.Category.SubtreeMembers</span>
        </li>
    }
</ul>
@if (outline.Count == 0)
{
    <p class="hint">No categories yet. File a page from the bar at the foot of it to start one.</p>
}

@code {
    private List<Row> outline = [];

    /// <summary>One line of the outline. A category nested under two parents is two rows,
    /// because it genuinely is in both places and hiding one would be a lie about the
    /// taxonomy — the id is what tells a reader they have met it before.</summary>
    private record Row(int Depth, CategorySummary Category);

    protected override async Task OnParametersSetAsync()
    {
        var all = await Ops.Categories(s => s.ListAsync(UserId));
        var known = all.ToDictionary(c => c.Id);
        var children = all
            .SelectMany(c => c.ParentIds.Where(known.ContainsKey).Select(p => (Parent: p, Child: c)))
            .ToLookup(pair => pair.Parent, pair => pair.Child);

        outline = [];
        // A parent the asking user cannot see makes its child a root for them, so roots
        // are "nothing above it that I can see" rather than "nothing above it".
        foreach (var root in all.Where(c => !c.ParentIds.Any(known.ContainsKey)))
            Walk(root, 0, []);

        void Walk(CategorySummary category, int depth, HashSet<Guid> above)
        {
            outline.Add(new Row(depth, category));
            // The taxonomy is a graph and a cycle cannot be filed, but a hand-edited
            // sidecar could still describe one, and a page that hangs is worse than a
            // page that stops early.
            if (!above.Add(category.Id))
                return;
            foreach (var child in children[category.Id].OrderBy(c => c.Name,
                StringComparer.OrdinalIgnoreCase))
                Walk(child, depth + 1, [.. above]);
        }
    }
}

@page "/"

<PageTitle>Gatherum</PageTitle>

<div class="home">
    <h1>Gatherum</h1>
    <p class="tagline">
        One tree where pages and files are the same kind of thing — a page is simply a
        Markdown file.
    </p>
    <p class="hint">
        Create a page or drop a file into the sidebar, or press
        <kbd>Ctrl</kbd>+<kbd>K</kbd> (<kbd>⌘K</kbd>) to search everything.
    </p>
</div>

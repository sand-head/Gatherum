@page "/tags"
@page "/tags/{TagName}"
@inherits GatherumComponent
@inject AppOperations Ops

<PageTitle>Tags — Gatherum</PageTitle>

@if (TagName is null)
{
    <h1>Tags</h1>
    <div class="tag-cloud">
        @foreach (var tag in tags)
        {
            <a class="tag" href="/tags/@Uri.EscapeDataString(tag.Name)">
                #@tag.Name <span class="count">@tag.NodeCount</span>
            </a>
        }
        @if (tags.Count == 0)
        {
            <p>No tags yet. Add one from any node's header.</p>
        }
    </div>
}
else
{
    <h1>#@TagName</h1>
    <ul class="node-list">
        @foreach (var node in tagged)
        {
            <li>
                <a href="/nodes/@node.Id">
                    <span class="node-icon">
                        @if (node.Kind == NodeKind.Page)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <path d="M14 2v6h6M9 13h6M9 17h6" />
                            </svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <path d="M14 2v6h6" />
                            </svg>
                        }
                    </span>
                    @node.Title
                </a>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public string? TagName { get; set; }

    private List<TagSummary> tags = [];
    private List<Node> tagged = [];

    protected override async Task OnParametersSetAsync()
    {
        if (TagName is null)
            tags = await Ops.Nodes(s => s.ListTagsAsync(UserId));
        else
            tagged = await Ops.Nodes(s => s.GetNodesWithTagAsync(UserId, TagName));
    }
}

@page "/nodes/{Id:guid}"
@inherits GatherumComponent
@inject AppOperations Ops
@using Gatherum.Core.Domain

@if (notFound)
{
    <PageTitle>Not found — Gatherum</PageTitle>
    <div class="node-missing">This node doesn't exist (or is private to someone else).</div>
}
else if (node is not null)
{
    <PageTitle>@node.Title — Gatherum</PageTitle>
    <article class="node">
        <NodeHeader NodeId="@node.Id" Title="@node.Title"
                    IsPrivate="@node.IsPrivate" Tags="@tags.ToArray()" />

        @if (editable)
        {
            <EditorPane @key="editorEpoch" NodeId="@node.Id" FileName="@fileName"
                        MediaType="@node.MediaType" />
        }
        else
        {
            <FileView NodeId="@node.Id" />
        }

        <VersionPanel NodeId="@node.Id" OnRestored="OnRestoredAsync" />

        @if (backlinks.Count > 0)
        {
            <section class="backlinks">
                <h3>Referenced by</h3>
                <ul>
                    @foreach (var source in backlinks)
                    {
                        <li><a href="/nodes/@source.Id">@source.Title</a></li>
                    }
                </ul>
            </section>
        }
    </article>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Node? node;
    private List<string> tags = [];
    private List<Node> backlinks = [];
    private string fileName = "";
    private bool editable;
    private bool notFound;
    private int editorEpoch;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            node = await Ops.Nodes(s => s.GetWithBodyAsync(UserId, Id));
            tags = node.Tags.Select(t => t.Tag!.Name).Order().ToList();
            backlinks = await Ops.Nodes(s => s.GetBacklinksAsync(UserId, Id));
            fileName = node.File is { Versions.Count: > 0 } file ? file.Current.FileName : "";
            editable = fileName.Length > 0 && MediaTypes.IsText(node.MediaType, fileName) &&
                node.File!.Current.SizeBytes <= 4 * 1024 * 1024;
            notFound = false;
        }
        catch (Gatherum.Core.NotFoundException)
        {
            node = null;
            notFound = true;
        }
    }

    private async Task OnRestoredAsync()
    {
        // Remounting the editor re-reads the restored content.
        editorEpoch++;
        await ReloadAsync();
    }
}

@page "/nodes/{Id:guid}"
@* A category is a page, so this is the page that renders one — there is no second
   article view to keep in step. The readable route is here rather than redirecting to
   the guid because a category name is the one address in this wiki a reader types. *@
@page "/categories/{Name}"
@inherits GatherumComponent
@using Microsoft.AspNetCore.Authorization
@* A node can be public or unlisted, so this page has to answer somebody with no session.
   What they are allowed to see is the authorizer's decision, not this page's. *@
@attribute [AllowAnonymous]
@inject AppOperations Ops
@using Gatherum.Core.Domain
@using Gatherum.Client

@if (notFound)
{
    <PageTitle>Not found — Gatherum</PageTitle>
    @if (Name is null)
    {
        <h1 class="node-missing">This node doesn't exist (or is private to someone else).</h1>
    }
    else
    {
        <h1 class="node-missing">Nothing here is about that (or it is private to someone else).</h1>
    }
}
else if (node is not null)
{
    <PageTitle>@node.Title — Gatherum</PageTitle>
    @if (node.Reach == NodeReach.WithLink)
    {
        @* Unlisted means the link is the permission, and a search engine that finds the
           link would hand it to everybody. Nothing here links to it, but a crawler can
           arrive by way of somebody else's page or a leaked referrer. *@
        <HeadContent>
            <meta name="robots" content="noindex, nofollow" />
        </HeadContent>
    }
    <article class="node">
        <NodeHeader @rendermode="InteractiveAuto" NodeId="@node.Id" Title="@node.Title"
                    Access="@node.Access.ToString()" Owned="@(node.OwnerId == ViewerId)"
                    OnAccessChanged="OnParametersSetAsync"
                    EditHref="@(editable && !Editing ? $"/nodes/{node.Id}?edit" : null)" />

        @* Which surface a page opens in is a product decision, and this is it: a page
           reads, and editing is a URL you go to. Reading is the common case by a wide
           margin, and the read view is real HTML — so the first response carries the
           article, and a reader gets find-in-page, native selection, reflow and a
           screen reader instead of a canvas. ?edit is bookmarkable and the back
           button leaves it, which is what a wiki's Edit tab has always been. *@
        @if (editable && Editing)
        {
            <NodeEditor @rendermode="InteractiveAuto" NodeId="@node.Id" FileName="@fileName"
                        MediaType="@node.MediaType" />
        }
        else if (category is not null && unwritten)
        {
            @* A category nobody has written yet is Wikipedia's redlinked category: it
               already lists what is in it, and says so instead of opening half a screen
               of empty document above the only thing on the page. *@
            <p class="node-unwritten">
                Nobody has said what belongs here yet.
                @if (editable)
                {
                    <a href="/nodes/@node.Id?edit">Write it</a><text>.</text>
                }
            </p>
        }
        else if (readable)
        {
            <NodeReader @rendermode="InteractiveAuto" NodeId="@node.Id" FileName="@fileName"
                        MediaType="@node.MediaType" />
        }
        else
        {
            <FileView @rendermode="InteractiveAuto" NodeId="@node.Id" />
        }

        @* A category's members go between its prose and its history: they are what the
           page is for, and the history of the lede is a footnote beside them. *@
        @if (category is not null)
        {
            <CategoryListing View="@category" Deep="@Deep" />
        }

        <VersionPanel @rendermode="InteractiveAuto" NodeId="@node.Id" />

        @if (backlinks.Count > 0)
        {
            <section class="backlinks">
                <h3>Referenced by</h3>
                <ul>
                    @foreach (var source in backlinks)
                    {
                        <li><a href="/nodes/@source.Id">@source.Title</a></li>
                    }
                </ul>
            </section>
        }

        @* Last on the page, under the history and under what links here — the foot of
           a wiki article is where its subjects belong, and they are the reader's way
           onward once the prose is done rather than a detour before it starts.

           Reading shows the names alone, Wikipedia's way: filing is editing, so the ×
           and the + appear with the editor. The exception is a node with no editor to
           be in — an image, an archive, a folder — where the read view is the only
           surface it has, so a signed-in viewer files it from there. *@
        <NodeCategories @rendermode="InteractiveAuto" NodeId="@node.Id"
                        Categories="@categories.ToArray()"
                        CanFile="@(SignedIn && (Editing || !editable))" />
    </article>
}

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>A category by name, from the readable route. Names are unique among
    /// categories, which is what makes the route resolvable at all.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Whether a category is listing its subcategories' pages too.</summary>
    [SupplyParameterFromQuery] public bool Deep { get; set; }

    /// <summary>Presence, not a value: Blazor binds a bool query parameter through
    /// bool.TryParse, which rejects "1" — and the URL wants to read as ?edit anyway.</summary>
    [SupplyParameterFromQuery(Name = "edit")]
    public string? Edit { get; set; }

    private bool Editing => Edit is not null;

    private Node? node;
    private CategoryView? category;
    private List<CategoryRef> categories = [];
    private List<Node> backlinks = [];
    private string fileName = "";
    private bool readable;
    private bool editable;
    private bool unwritten;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var id = Id;
            if (Name is not null)
            {
                // Resolving the name is not a visibility decision — that is the node
                // read's job, exactly as it is for a guid somebody was handed.
                var named = await Ops.Categories(s => s.ResolveAsync(Name))
                    ?? throw new Gatherum.Core.NotFoundException($"No category '{Name}'.");
                id = named.Id;
            }
            node = await Ops.Nodes(s => s.GetWithBodyAsync(ViewerId, id));
            categories = node.Categories
                .Select(c => new CategoryRef(c.CategoryId, c.Category!.Title))
                .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            category = node.IsCategory
                ? await Ops.Categories(s => s.GetAsync(ViewerId, node.Title, Deep))
                : null;
            backlinks = await Ops.Nodes(s => s.GetBacklinksAsync(ViewerId, node.Id));
            fileName = node.File is { Versions.Count: > 0 } file ? file.Current.FileName : "";
            // What the document surfaces can open at all — a page, a source file, a docx.
            // Reading one is what publishing a page means, so this asks nothing about who
            // is looking; a file with no document form falls through to FileView.
            readable = fileName.Length > 0
                && node.File!.Current.SizeBytes <= 4 * 1024 * 1024
                && (MediaTypes.IsText(node.MediaType, fileName) || node.MediaType == MediaTypes.Docx);
            // Editing is never offered to somebody who is not signed in, whatever the
            // node says — public is a publishing gesture, not an invitation.
            editable = readable && SignedIn;
            unwritten = node.File is { Versions.Count: > 0 } body
                && body.Current.ExtractedText.Trim().Length == 0;
            notFound = false;
        }
        catch (Gatherum.Core.NotFoundException)
        {
            node = null;
            category = null;
            notFound = true;
        }
    }
}

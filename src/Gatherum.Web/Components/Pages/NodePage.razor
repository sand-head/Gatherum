@page "/nodes/{Id:guid}"
@inherits GatherumComponent
@inject AppOperations Ops
@using Gatherum.Core.Domain
@using Gatherum.Client

@if (notFound)
{
    <PageTitle>Not found — Gatherum</PageTitle>
    <h1 class="node-missing">This node doesn't exist (or is private to someone else).</h1>
}
else if (node is not null)
{
    <PageTitle>@node.Title — Gatherum</PageTitle>
    <article class="node">
        <NodeHeader @rendermode="InteractiveAuto" NodeId="@node.Id" Title="@node.Title"
                    IsPrivate="@node.IsPrivate" Categories="@categories.ToArray()"
                    EditHref="@(editable && !Editing ? $"/nodes/{node.Id}?edit" : null)" />

        @* Which surface a page opens in is a product decision, and this is it: a page
           reads, and editing is a URL you go to. Reading is the common case by a wide
           margin, and the read view is real HTML — so the first response carries the
           article, and a reader gets find-in-page, native selection, reflow and a
           screen reader instead of a canvas. ?edit is bookmarkable and the back
           button leaves it, which is what a wiki's Edit tab has always been. *@
        @if (editable && Editing)
        {
            <NodeEditor @rendermode="InteractiveAuto" NodeId="@node.Id" FileName="@fileName"
                        MediaType="@node.MediaType" />
        }
        else if (editable)
        {
            <NodeReader @rendermode="InteractiveAuto" NodeId="@node.Id" FileName="@fileName"
                        MediaType="@node.MediaType" />
        }
        else
        {
            <FileView @rendermode="InteractiveAuto" NodeId="@node.Id" />
        }

        <VersionPanel @rendermode="InteractiveAuto" NodeId="@node.Id" />

        @if (backlinks.Count > 0)
        {
            <section class="backlinks">
                <h3>Referenced by</h3>
                <ul>
                    @foreach (var source in backlinks)
                    {
                        <li><a href="/nodes/@source.Id">@source.Title</a></li>
                    }
                </ul>
            </section>
        }
    </article>
}

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>Presence, not a value: Blazor binds a bool query parameter through
    /// bool.TryParse, which rejects "1" — and the URL wants to read as ?edit anyway.</summary>
    [SupplyParameterFromQuery(Name = "edit")]
    public string? Edit { get; set; }

    private bool Editing => Edit is not null;

    private Node? node;
    private List<CategoryRef> categories = [];
    private List<Node> backlinks = [];
    private string fileName = "";
    private bool editable;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            node = await Ops.Nodes(s => s.GetWithBodyAsync(UserId, Id));
            categories = node.Categories
                .Select(c => new CategoryRef(c.Category!.Path, c.Category.Name))
                .OrderBy(c => c.Path)
                .ToList();
            backlinks = await Ops.Nodes(s => s.GetBacklinksAsync(UserId, Id));
            fileName = node.File is { Versions.Count: > 0 } file ? file.Current.FileName : "";
            editable = fileName.Length > 0 && node.File!.Current.SizeBytes <= 4 * 1024 * 1024 &&
                (MediaTypes.IsText(node.MediaType, fileName) || node.MediaType == MediaTypes.Docx);
            notFound = false;
        }
        catch (Gatherum.Core.NotFoundException)
        {
            node = null;
            notFound = true;
        }
    }
}

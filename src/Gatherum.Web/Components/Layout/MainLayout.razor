@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="shell">
    <header class="topbar">
        @* Only ever visible below the shell breakpoint, where the sidebar is a
           drawer. popovertarget does the whole job: top layer, light-dismiss,
           Escape, and a backdrop — the same mechanism as the account menu. *@
        <button type="button" class="nav-toggle" popovertarget="nav-drawer"
                title="Navigation" aria-label="Open navigation">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </button>
        <a class="brand" href="/">Gatherum</a>
        <div class="topbar-search">
            <SearchPalette @rendermode="InteractiveAuto" />
        </div>
        <div class="topbar-actions">
            <button type="button" id="theme-toggle" class="theme-toggle"
                    title="Theme: system → light → dark" aria-label="Toggle color theme">
                <svg class="icon-system" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none" />
                </svg>
                <svg class="icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4.5" />
                    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
                </svg>
                <svg class="icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                </svg>
            </button>
            @* A signed-out visitor is reading something public or something they hold a
               link to. Nothing here writes, so nothing here is offered to them. *@
            <AuthorizeView>
                <Authorized>
                    <HeaderActions @rendermode="InteractiveAuto" />
                </Authorized>
                <NotAuthorized>
                    <a class="signin" href="/auth/login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
            <AuthorizeView>
            <Authorized>
            <button type="button" class="account-button" popovertarget="account-menu"
                    title="Account" aria-label="Account menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" />
                </svg>
            </button>
            @* Native popover: top-layer, light-dismiss, zero JS. *@
            <div id="account-menu" popover class="account-menu">
                <a href="/settings">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h.09a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v.09a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1z" />
                    </svg>
                    Settings
                </a>
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <button type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                        </svg>
                        Sign out
                    </button>
                </form>
            </div>
            </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <div class="body">
        @* Carries the popover attribute at every width, but only behaves as one
           below the breakpoint: above it the .sidebar rule's own display beats
           the UA's [popover] display:none and the aside sits in flow as before. *@
        <aside id="nav-drawer" popover class="sidebar">
            @* Reading context, not a file manager: the article's contents, similar
               articles, and recent visits. The full tree lives at /pages. *@
            <AuthorizeView>
                <Authorized>
                    <SidebarPanels @rendermode="InteractiveAuto" />
                </Authorized>
            </AuthorizeView>
            <nav class="sidebar-foot">
                <NavLink href="/pages">All pages</NavLink>
                <NavLink href="/categories">Categories</NavLink>
            </nav>
        </aside>
        <main class="content">
            @Body
        </main>
    </div>
</div>

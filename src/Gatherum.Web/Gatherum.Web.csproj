<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- The manual travels inside the assembly: a deployment cannot forget to copy a
         directory it does not have to copy. See Services/DocsLibrary.cs. -->
    <None Remove="Docs\*.md" />
    <EmbeddedResource Include="Docs\*.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gatherum.Client\Gatherum.Client.csproj" />
    <ProjectReference Include="..\Gatherum.Core\Gatherum.Core.csproj" />
    <ProjectReference Include="..\Gatherum.Infrastructure\Gatherum.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <!-- The vendored emulator core, staged into wwwroot so the browser fetches it from
       this app's own origin and no deployment reaches anybody else's server to play a
       game. It is produced by native/build-core.sh, which the Docker build runs in a
       stage of its own; a working copy that has never run it simply has no Game Boy
       Advance core, and those cartridges offer a download instead of a console. -->
  <!-- Whatever native/build-core.sh has left behind. A core is fetched and built rather
       than committed, so a tree that has never run it simply serves no vendored core and
       every machine written in C# still plays. -->
  <ItemGroup>
    <EmulatorCoreFile Include="$(MSBuildThisFileDirectory)..\..\native\dist\*.wasm;
                               $(MSBuildThisFileDirectory)..\..\native\dist\*.mjs" />
  </ItemGroup>

  <Target Name="StageEmulatorCores" BeforeTargets="ResolveStaticWebAssetsInputs;AssignTargetPaths"
          Condition="'@(EmulatorCoreFile)' != ''">
    <Copy SourceFiles="@(EmulatorCoreFile)"
          DestinationFolder="$(MSBuildThisFileDirectory)wwwroot\cores\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
@inject TreeState State

@{
    var children = State.ByParent[Node.Id].ToList();
    var isExpanded = Tree.IsExpanded(Node.Id);
}
<div class="tree-item" style="--depth: @Depth">
    <div class="tree-row">
        @if (children.Count > 0)
        {
            <button class="chevron @(isExpanded ? "open" : "")" title="@(isExpanded ? "Collapse" : "Expand")"
                    @onclick="() => Tree.Toggle(Node.Id)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 6 6 6-6 6" />
                </svg>
            </button>
        }
        else
        {
            <span class="chevron"></span>
        }
        <NavLink class="tree-link" href="@($"/nodes/{Node.Id}")">
            <span class="node-icon">
                @if (Node.Kind == "Page")
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6M9 13h6M9 17h6" />
                    </svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6" />
                    </svg>
                }
            </span>
            <span class="node-title">@Node.Title</span>
            @* Private is the default, so it is the exceptions that earn a badge:
               shared with somebody, or out on the internet. *@
            @if (Node.IsPublic)
            {
                <span class="node-public" title="Public — anyone on the internet can read this">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
                    </svg>
                </span>
            }
            else if (Node.Access == "Shared")
            {
                <span class="node-shared" title="Shared with someone">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    </svg>
                </span>
            }
            @if (!Node.Owned)
            {
                <span class="node-foreign" title="Shared with you — lives in its owner's tree">↗</span>
            }
        </NavLink>
        <button class="row-menu" title="More actions" @onclick="() => menuOpen = !menuOpen">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="5" r="1.9" />
                <circle cx="12" cy="12" r="1.9" />
                <circle cx="12" cy="19" r="1.9" />
            </svg>
        </button>
    </div>
    @if (menuOpen)
    {
        <div class="menu" @onclick="() => menuOpen = false">
            <button @onclick="() => Tree.CreatePageAsync(Node.Id)">New page inside</button>
            <label class="upload-label menu-upload">
                Upload file inside
                <InputFile OnChange="e => Tree.UploadAsync(e, Node.Id)" multiple />
            </label>
            <button @onclick="() => Tree.MoveBy(Node, -1)">Move up</button>
            <button @onclick="() => Tree.MoveBy(Node, +1)">Move down</button>
            <button @onclick="() => Tree.BeginMove(Node)">Move to…</button>
            @* Publishing is the gesture worth making visible and a little alarming;
               sharing with a person needs a name, and goes through the share control. *@
            <button disabled="@(!Node.Owned)" @onclick="() => Tree.TogglePublicAsync(Node)">
                @(Node.IsPublic ? "Unpublish" : "Publish to the internet…")
            </button>
            <button class="danger" @onclick="() => Tree.DeleteAsync(Node)">Delete</button>
        </div>
    }
    @if (isExpanded)
    {
        @foreach (var child in children)
        {
            <TreeItem Node="child" Depth="Depth + 1" Tree="Tree" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public TreeNodeInfo Node { get; set; } = null!;
    [Parameter] public int Depth { get; set; }
    [Parameter, EditorRequired] public NodeTree Tree { get; set; } = null!;

    private bool menuOpen;
}

@inject TreeState State

@{
    var children = State.ByParent[Node.Id].ToList();
    var isExpanded = Tree.IsExpanded(Node.Id);
}
<div class="tree-item" style="--depth: @Depth">
    <div class="tree-row">
        @if (children.Count > 0)
        {
            <button class="chevron @(isExpanded ? "open" : "")" title="@(isExpanded ? "Collapse" : "Expand")"
                    @onclick="() => Tree.Toggle(Node.Id)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 6 6 6-6 6" />
                </svg>
            </button>
        }
        else
        {
            <span class="chevron"></span>
        }
        <NavLink class="tree-link" href="@($"/nodes/{Node.Id}")">
            <span class="node-icon">
                @if (Node.Kind == "Page")
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6M9 13h6M9 17h6" />
                    </svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6" />
                    </svg>
                }
            </span>
            <span class="node-title">@Node.Title</span>
            @* Private is the default, so it is the exceptions that earn a badge:
               shared with somebody, or out on the internet. *@
            @if (Node.Reach == "Listed")
            {
                <span class="node-public node-badge" title="Public — anyone on the internet can read this">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
                    </svg>
                </span>
            }
            else if (Node.Reach == "WithLink")
            {
                <span class="node-unlisted node-badge" title="Unlisted — anyone with the link can read this">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" />
                        <path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" />
                    </svg>
                </span>
            }
            else if (Node.ListedToSignedIn)
            {
                <span class="node-authenticated node-badge" title="Authenticated — everyone signed in to this Gatherum can read this">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
            }
            else if (Node.Access == "Shared")
            {
                <span class="node-shared node-badge" title="Shared with someone">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    </svg>
                </span>
            }
            @if (!Node.Owned)
            {
                <span class="node-foreign node-badge" title="Shared with you — lives in its owner's tree">↗</span>
            }
        </NavLink>
        <button class="row-menu" title="More actions" @onclick="() => menuOpen = !menuOpen">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="5" r="1.9" />
                <circle cx="12" cy="12" r="1.9" />
                <circle cx="12" cy="19" r="1.9" />
            </svg>
        </button>
    </div>
    @if (menuOpen)
    {
        <div class="menu" @onclick="() => menuOpen = false">
            <button @onclick="() => Tree.CreatePageAsync(Node.Id)">New page inside</button>
            <label class="upload-label menu-upload">
                Upload file inside
                <InputFile OnChange="e => Tree.UploadAsync(e, Node.Id)" multiple />
            </label>
            <button @onclick="() => Tree.BeginBookmark(Node.Id)">Bookmark a page inside</button>
            <button @onclick="() => Tree.MoveBy(Node, -1)">Move up</button>
            <button @onclick="() => Tree.MoveBy(Node, +1)">Move down</button>
            <button @onclick="() => Tree.BeginMove(Node)">Move to…</button>
            @* Three states worth naming rather than a toggle to cycle. Publishing is the
               one that deserves to read as a decision, so it says where it puts you. *@
            @if (Node.Owned)
            {
                <div class="menu-group" role="group" aria-label="Who can reach this">
                    <button class="@(Node.Reach == "None" && !Node.ListedToSignedIn ? "chosen" : null)"
                            @onclick='() => Tree.SetAccessAsync(Node, "Private")'>
                        Private
                    </button>
                    <button class="@(Node.Access == "Authenticated" ? "chosen" : null)"
                            @onclick='() => Tree.SetAccessAsync(Node, "Authenticated")'>
                        Authenticated — everyone signed in here
                    </button>
                    <button class="@(Node.Reach == "WithLink" ? "chosen" : null)"
                            @onclick='() => Tree.SetAccessAsync(Node, "Unlisted")'>
                        Unlisted — anyone with the link
                    </button>
                    <button class="@(Node.Reach == "Listed" ? "chosen" : null)"
                            @onclick='() => Tree.SetAccessAsync(Node, "Public")'>
                        Public — on the internet
                    </button>
                </div>
            }
            <button class="danger" @onclick="() => Tree.DeleteAsync(Node)">Delete</button>
        </div>
    }
    @if (isExpanded)
    {
        @foreach (var child in children)
        {
            <TreeItem Node="child" Depth="Depth + 1" Tree="Tree" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public TreeNodeInfo Node { get; set; } = null!;
    [Parameter] public int Depth { get; set; }
    [Parameter, EditorRequired] public NodeTree Tree { get; set; } = null!;

    private bool menuOpen;
}

@implements IAsyncDisposable
@inject IAppData Data
@inject OutlineState Outline
@inject ThemeState AppTheme
@inject NavigationManager Navigation
@using SlopEdit.Blazor
@using SlopEdit.Core.Document
@using SlopEdit.Docx
@using SlopEdit.Core.Highlighting
@using SlopEdit.Core.Input
@using SlopEdit.Core.Rich

<div class="editor-pane">
    <div class="editor-toolbar">
        <span class="presence">
            @foreach (var editor in othersEditing)
            {
                <span class="presence-chip">@editor is editing</span>
            }
        </span>
        @if (staleWarning)
        {
            <span class="stale-warning">Someone saved a newer version — your next save
                makes a new one; theirs stays in history.</span>
        }
        @if (IsMarkdown)
        {
            <div class="insert">
                <button class="ghost" @onclick="() => insertOpen = !insertOpen">Insert…</button>
                @if (insertOpen)
                {
                    <div class="scrim" @onclick="() => insertOpen = false"></div>
                    <div class="insert-menu">
                        <button @onclick="() => OpenPicker(Picker.WikiLink)">Wiki link…</button>
                        <button @onclick="InsertInfoboxAsync">Infobox</button>
                        <button @onclick="() => OpenPicker(Picker.Figure)">Figure…</button>
                        <div class="insert-group">Callout</div>
                        @foreach (var (kind, name) in CalloutExtension.Kinds)
                        {
                            <button @onclick="() => InsertCalloutAsync(kind)">@name</button>
                        }
                    </div>
                }
            </div>
        }
        <button class="ghost" @onclick="() => OpenPicker(Picker.Mention)">Link node…</button>
        @if (IsMarkdown)
        {
            <button class="ghost" @onclick="ToggleSource">
                @(sourceMode ? "Document" : "Source")
            </button>
        }
        <span class="save-indicator">@saveLabel</span>
        @* Editing is a URL now, so leaving it is a navigation — and it has to flush
           what autosave has not written yet before it goes. *@
        <button class="primary" @onclick="DoneAsync">Done</button>
        <span class="render-home" title="Where the editor is rendering">
            @(RendererInfo.IsInteractive ? RendererInfo.Name : "…")
        </span>
    </div>

    @if (richDoc is not null && !sourceMode)
    {
        <div class="document-surface">
            @* ContentPadding: 0 to match the read view. It sets the column the layout
               measures, so the two surfaces wrap at the same points only while they
               agree about it — the pane's own padding is the article's margin. *@
            <DocumentView @ref="docView" Grid="richDoc" OnChange="OnChanged"
                          Theme="EditorThemes.For(AppTheme.IsDark)" ContentPadding="0"
                          ImageSource="Data.GetImageAsync" OnLinkActivated="FollowLinkAsync"
                          AriaLabel="Document editor" />
        </div>
    }
    else if (sourceDoc is not null)
    {
        <div class="editor-surface">
            <EditorView @ref="sourceView" Grid="sourceDoc" OnChange="OnChanged"
                        Theme="EditorThemes.For(AppTheme.IsDark)"
                        AriaLabel="Source editor" />
        </div>
    }

    @if (picker != Picker.None)
    {
        <div class="mention-dialog">
            @* Escape was the only way out, which is not a way out on a phone. *@
            <button class="picker-close" title="Close" aria-label="Close"
                    @onclick="() => picker = Picker.None">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" />
                </svg>
            </button>
            <input placeholder="@PickerPlaceholder" value="@pickerQuery"
                   @oninput="OnPickerQuery" @onkeydown="OnPickerKey" autofocus />
            @if (picker == Picker.WikiLink && pickerQuery.Trim().Length > 0)
            {
                <button class="ghost new-title"
                        @onclick="() => InsertWikiLinkAsync(pickerQuery.Trim())">
                    Link to “@pickerQuery.Trim()”
                </button>
            }
            <div class="mention-results">
                @foreach (var result in pickerResults)
                {
                    <button @onclick="() => ChooseAsync(result)">
                        <span class="kind">@result.Kind</span> @result.Title
                    </button>
                }
            </div>
        </div>
    }

    @if (deadLink is not null)
    {
        <div class="mention-dialog dead-link">
            <p>Nothing here is titled “@deadLink”.</p>
            <div class="dead-link-actions">
                <button class="primary" @onclick="CreateDeadLinkAsync">Write it</button>
                <button class="ghost" @onclick="() => deadLink = null">Not now</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid NodeId { get; set; }
    [Parameter, EditorRequired] public string FileName { get; set; } = "";
    [Parameter, EditorRequired] public string MediaType { get; set; } = "";

    private RichDocument? richDoc;
    private EditorDocument? sourceDoc;
    private DocumentView? docView;
    private EditorView? sourceView;
    private bool sourceMode;
    private string saveLabel = "";
    private bool staleWarning;
    private bool dirty;
    private int lastKnownHead;
    private IReadOnlyList<string> othersEditing = [];
    private System.Threading.Timer? saveTimer;
    private System.Threading.Timer? presenceTimer;

    private bool IsMarkdown => MediaType == "text/markdown";
    private bool IsDocx =>
        MediaType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";

    /// <summary>What the node picker is being asked for. One dialog, because all three
    /// answers are "a node", and two of them may also be a title nobody has written yet.</summary>
    private enum Picker { None, Mention, WikiLink, Figure }

    private Picker picker;
    private string pickerQuery = "";
    private IReadOnlyList<SearchHit> pickerResults = [];
    private bool insertOpen;
    private string? deadLink;

    /// <summary>Titles this document wiki-links that currently resolve; everything else
    /// it links is a red link. Kept so a theme change can re-ink without asking again.</summary>
    private IReadOnlySet<string> liveTitles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    private string PickerPlaceholder => picker switch
    {
        Picker.WikiLink => "Title to link…",
        Picker.Figure => "Image to set beside the text…",
        _ => "Search nodes…",
    };

    protected override async Task OnInitializedAsync()
    {
        // Prerender has no JS to watch the theme with; the canvas painted during
        // prerender is a placeholder frame anyway.
        if (RendererInfo.IsInteractive)
        {
            await AppTheme.EnsureWatchingAsync();
            AppTheme.Changed += OnAppThemeChanged;
        }
        if (IsDocx)
        {
            var payload = await Data.LoadBytesAsync(NodeId);
            lastKnownHead = payload.HeadVersion;
            using var docx = new MemoryStream(payload.Content);
            richDoc = DocxConverter.ToRichDocument(docx);
        }
        else
        {
            var payload = await Data.LoadAsync(NodeId);
            lastKnownHead = payload.HeadVersion;
            if (IsMarkdown)
                richDoc = GatherumMarkdown.Parse(payload.Text, AppTheme.IsDark);
            else
            {
                sourceDoc = new EditorDocument(payload.Text) { Lexer = LexerRegistry.ForPath(FileName) };
                sourceMode = true;
            }
        }
        presenceTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(HeartbeatAsync), null, 0, 5000);
        ApplyEditorTheme();
        Outline.JumpRequested += OnJumpRequested;
        PublishOutline();
        await ResolveWikiLinksAsync();
    }

    /// <summary>Colors that live on the documents rather than the views — and, for a
    /// page, the chrome its constructs wear, which is derived from the same palette.</summary>
    private void ApplyEditorTheme()
    {
        if (richDoc is not null)
            GatherumMarkdown.Dress(richDoc, AppTheme.IsDark);
        if (sourceDoc is not null)
            sourceDoc.SyntaxTheme = EditorThemes.Syntax(AppTheme.IsDark);
    }

    private void OnAppThemeChanged() => _ = InvokeAsync(() =>
    {
        ApplyEditorTheme();
        InkWikiLinks();
        StateHasChanged();
    });

    private string CurrentText => sourceMode || richDoc is null
        ? sourceDoc?.Text ?? ""
        : GatherumMarkdown.ToMarkdown(richDoc);

    private async Task PersistAsync()
    {
        if (IsDocx)
        {
            using var docx = new MemoryStream();
            DocxConverter.FromRichDocument(richDoc!, docx);
            lastKnownHead = await Data.SaveBytesAsync(NodeId, docx.ToArray());
        }
        else
        {
            lastKnownHead = await Data.SaveTextAsync(NodeId, CurrentText);
        }
    }

    private void OnChanged(string changedText)
    {
        // Decorations and floats are pinned to block indices, and typing moves them:
        // the chrome is re-derived from the blocks' own tags after every edit.
        if (richDoc is not null && !sourceMode)
            DocumentChrome.Apply(richDoc, AppTheme.IsDark);
        PublishOutline();
        dirty = true;
        saveLabel = "Saving…";
        saveTimer?.Dispose();
        saveTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(SaveAsync), null, 1200, Timeout.Infinite);
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (disposed)
            return;
        try
        {
            await PersistAsync();
            dirty = false;
            staleWarning = false;
            saveLabel = "Saved";
        }
        catch (Exception) when (!disposed)
        {
            // A background save must not take the circuit down with it; retry instead.
            saveLabel = "Save failed — retrying";
            saveTimer?.Dispose();
            saveTimer = new System.Threading.Timer(
                _ => _ = InvokeAsync(SaveAsync), null, 3000, Timeout.Infinite);
        }
        catch (Exception)
        {
            return;
        }
        StateHasChanged();
        await ResolveWikiLinksAsync();
    }

    /// <summary>Leaving the page is not a save point the debounce knows about, so
    /// anything a link is about to navigate away from goes to the server first.</summary>
    private async Task FlushAsync()
    {
        saveTimer?.Dispose();
        if (dirty)
            await SaveAsync();
    }

    private async Task HeartbeatAsync()
    {
        if (disposed)
            return;
        try
        {
            var presence = await Data.HeartbeatAsync(NodeId);
            othersEditing = presence.Editors;
            if (presence.HeadVersion > lastKnownHead)
                staleWarning = true;
            StateHasChanged();
        }
        catch (Exception)
        {
            // The next heartbeat retries; a blip (or teardown) must not kill the circuit.
        }
    }

    /// <summary>Both editors hold the same content in different models; switching
    /// converts through Markdown, which the Markdown profile round-trips losslessly —
    /// the wiki's own syntaxes included, since both sides read the same extension set.</summary>
    private void ToggleSource()
    {
        if (sourceMode)
        {
            richDoc = GatherumMarkdown.Parse(sourceDoc?.Text ?? "", AppTheme.IsDark);
            sourceMode = false;
        }
        else
        {
            sourceDoc = new EditorDocument(GatherumMarkdown.ToMarkdown(richDoc!))
            {
                Lexer = LexerRegistry.ForPath(FileName),
            };
            sourceMode = true;
        }
        ApplyEditorTheme();
        PublishOutline();
        _ = ResolveWikiLinksAsync();
    }

    /// <summary>A link the reader Ctrl+clicked — a plain click still places the caret.
    /// Where it goes is <see cref="LinkRouter"/>'s answer, shared with the read view;
    /// what is done with it is the editor's, because there is a save to flush first and
    /// a title nobody has written yet is an offer rather than an error.</summary>
    private async Task FollowLinkAsync(string url)
    {
        LinkRouter.Target target;
        try
        {
            target = await LinkRouter.ResolveAsync(Data, url);
        }
        catch (Exception)
        {
            // A link that can't be resolved right now stays where it is; the click
            // is not worth taking the editor down for.
            saveLabel = "Couldn't reach the server";
            return;
        }
        switch (target.Kind)
        {
            case LinkRouter.LinkKind.Node:
                await GoToAsync(target.Url);
                break;
            case LinkRouter.LinkKind.External:
                await GoToAsync(target.Url, external: true);
                break;
            case LinkRouter.LinkKind.UnwrittenTitle:
                deadLink = target.Title;
                break;
        }
    }

    private Task DoneAsync() => GoToAsync($"/nodes/{NodeId}");

    private async Task GoToAsync(string url, bool external = false)
    {
        await FlushAsync();
        Navigation.NavigateTo(url, forceLoad: external);
    }

    private async Task CreateDeadLinkAsync()
    {
        var title = deadLink!;
        deadLink = null;
        await FlushAsync();
        try
        {
            var created = await Data.CreatePageAsync(null, title);
            Navigation.NavigateTo($"/nodes/{created}");
        }
        catch (Exception)
        {
            saveLabel = "Couldn't write that page";
        }
    }

    /// <summary>Ask which of this document's wiki links point at something, and ink
    /// them accordingly. Runs after loading and after every save: the answer changes
    /// when the other user writes the page this one has been asking for.</summary>
    private async Task ResolveWikiLinksAsync()
    {
        if (richDoc is null || sourceMode)
            return;
        var targets = WikiLinks.TargetsIn(richDoc);
        if (targets.Count == 0)
        {
            liveTitles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            return;
        }
        try
        {
            var resolved = await Data.ResolveTitlesAsync(targets);
            liveTitles = resolved.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);
            InkWikiLinks();
        }
        catch (Exception)
        {
            // A resolution blip leaves the links inked however they were; the next
            // save asks again.
        }
    }

    private void InkWikiLinks()
    {
        if (richDoc is not null && !sourceMode &&
            WikiLinks.Mark(richDoc, liveTitles, ChromeInk.For(AppTheme.IsDark)))
            richDoc.InvalidateLayout();
    }

    /// <summary>Hands the sidebar the current headings. Block index in document mode,
    /// line index in source mode — OnJumpRequested interprets them the same way.</summary>
    private void PublishOutline()
    {
        if (!sourceMode && richDoc is not null)
        {
            var entries = new List<OutlineEntry>();
            for (var i = 0; i < richDoc.Blocks.Count; i++)
            {
                // An aside's own headings title the card, not the page.
                if (richDoc.Blocks[i] is { Kind: BlockKind.Heading, Tag: null } block)
                    entries.Add(new OutlineEntry(i, block.HeadingLevel, block.Text));
            }
            Outline.Publish(this, entries);
        }
        else if (sourceMode && sourceDoc is not null && IsMarkdown)
        {
            Outline.Publish(this, MarkdownHeadings(sourceDoc.Text));
        }
        else
        {
            Outline.Clear(this);
        }
    }

    private static List<OutlineEntry> MarkdownHeadings(string markdown)
    {
        var entries = new List<OutlineEntry>();
        var inFence = false;
        var lines = markdown.Split('\n');
        for (var i = 0; i < lines.Length; i++)
        {
            var line = lines[i].TrimEnd();
            if (line.StartsWith("```") || line.StartsWith("~~~"))
            {
                inFence = !inFence;
                continue;
            }
            if (inFence)
                continue;
            var level = 0;
            while (level < line.Length && level < 6 && line[level] == '#')
                level++;
            if (level > 0 && level < line.Length && line[level] == ' ')
                entries.Add(new OutlineEntry(i, level, line[(level + 1)..].Trim()));
        }
        return entries;
    }

    private async Task OnJumpRequested(OutlineEntry entry)
    {
        if (!sourceMode && richDoc is not null && docView is not null)
        {
            await JumpToBlockAsync(entry.Block);
        }
        else if (sourceMode && sourceDoc is not null && sourceView is not null)
        {
            sourceDoc.MoveTo(Math.Min(entry.Block, sourceDoc.LineCount - 1), 0, extend: false);
            await sourceView.FocusAsync();
            sourceView.RevealCaret();
        }
    }

    /// <summary>Put the caret at the start of a block, by way of the row it starts on —
    /// a block spans as many rows as its text wraps into.</summary>
    private async Task JumpToBlockAsync(int block)
    {
        if (richDoc is null || docView is null)
            return;
        for (var row = 0; row < richDoc.LineCount; row++)
        {
            var info = richDoc.RowInfoAt(row);
            if (info.Block != block || !info.FirstRowOfBlock)
                continue;
            richDoc.MoveTo(row, 0, extend: false);
            await docView.FocusAsync();
            docView.RevealCaret();
            return;
        }
    }

    private void OpenPicker(Picker mode)
    {
        insertOpen = false;
        picker = mode;
        pickerQuery = "";
        pickerResults = [];
    }

    private async Task OnPickerQuery(ChangeEventArgs e)
    {
        pickerQuery = e.Value?.ToString() ?? "";
        if (pickerQuery.Length == 0)
        {
            pickerResults = [];
            return;
        }
        var hits = await Data.SearchAsync(pickerQuery, limit: 8);
        // A figure is a picture: pages have no bytes to show.
        pickerResults = picker == Picker.Figure
            ? hits.Where(h => h.Kind == "File").ToList()
            : hits;
    }

    private void OnPickerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            picker = Picker.None;
    }

    private async Task ChooseAsync(SearchHit hit)
    {
        var mode = picker;
        picker = Picker.None;
        switch (mode)
        {
            case Picker.Mention:
                InsertMention(hit);
                break;
            case Picker.WikiLink:
                await InsertWikiLinkAsync(hit.Title);
                break;
            case Picker.Figure:
                await InsertConstructAsync($"""
                    :::figure right 320
                    ![{hit.Title}](/api/files/{hit.Id}/content)
                    {hit.Title}
                    :::
                    """);
                break;
        }
    }

    private void InsertMention(SearchHit hit)
    {
        picker = Picker.None;
        InsertLink($"@{hit.Title}", $"node://{hit.Id}");
        OnChanged("");
    }

    private async Task InsertWikiLinkAsync(string title)
    {
        picker = Picker.None;
        if (sourceMode)
            sourceDoc?.Insert($"[[{title}]]");
        else
            InsertLink(title, WikiLinkExtension.UrlOf(title));
        OnChanged("");
        await ResolveWikiLinksAsync();
    }

    /// <summary>The rich model has no markup: insert the label, select it backwards,
    /// link the selection, then collapse the caret past it.</summary>
    private void InsertLink(string label, string url)
    {
        if (sourceMode || richDoc is null)
        {
            sourceDoc?.Insert($"[{label}]({url})");
            return;
        }
        richDoc.Insert(label);
        for (var i = 0; i < label.Length; i++)
            richDoc.Execute(EditorCommand.MoveLeft, extend: true);
        richDoc.SetLink(url);
        richDoc.Execute(EditorCommand.MoveRight, extend: false);
    }

    private Task InsertInfoboxAsync() => InsertConstructAsync($"""
        :::infobox
        # {PageName}
        | **Label** | Value |
        :::
        """);

    private Task InsertCalloutAsync(string kind) => InsertConstructAsync($"""
        > [!{kind.ToUpperInvariant()}]
        > Something worth setting apart.
        """);

    private string PageName
    {
        get
        {
            var name = Path.GetFileNameWithoutExtension(FileName);
            return name.Length > 0 ? name : "Overview";
        }
    }

    /// <summary>Insert a construct at the caret's block. The document editor has no way
    /// to type a fence into being — the extensions read source, and this document is
    /// past that — so the page is written back out around the snippet and read again.
    /// The cost is the undo stack, which is why this is a menu item and not a keystroke.</summary>
    private async Task InsertConstructAsync(string snippet)
    {
        insertOpen = false;
        if (sourceMode)
        {
            sourceDoc?.Insert(snippet + "\n");
            OnChanged("");
            return;
        }
        if (richDoc is null)
            return;
        var at = PastConstructAt(CaretBlockIndex());
        var before = GatherumMarkdown.ToMarkdown(richDoc, 0, at);
        var after = GatherumMarkdown.ToMarkdown(richDoc, at, richDoc.Blocks.Count - at);

        var parts = new List<string>();
        if (before.Length > 0)
            parts.AddRange([before, ""]);
        parts.Add(snippet);
        if (after.Length > 0)
            parts.AddRange(["", after]);

        GatherumMarkdown.Reload(richDoc, string.Join('\n', parts), AppTheme.IsDark);
        OnChanged("");
        // The prefix round-trips block for block, and the blank line between it and the
        // snippet is a block of its own — so that is where the construct starts.
        await JumpToBlockAsync(FirstWritableBlock(before.Length > 0 ? at + 1 : 0));
    }

    /// <summary>Where the caret goes after a construct is inserted: its first block that
    /// holds text, so a figure lands on its caption rather than inside its picture —
    /// an image block has nothing to type into.</summary>
    private int FirstWritableBlock(int from)
    {
        for (var i = from; richDoc is not null && i < richDoc.Blocks.Count; i++)
        {
            if (richDoc.Blocks[i].Kind != BlockKind.Image)
                return i;
        }
        return from;
    }

    /// <summary>Past whatever the caret is inside: a construct is one run of blocks that
    /// its own source fence surrounds, so inserting into the middle of one would split it
    /// in two around the newcomer. An aside gets the new thing after it, not inside it.</summary>
    private int PastConstructAt(int block)
    {
        if (richDoc is null || block >= richDoc.Blocks.Count)
            return block;
        if (richDoc.Blocks[block].Tag is not { } tag)
            return block;
        while (block < richDoc.Blocks.Count && richDoc.Blocks[block].Tag == tag)
            block++;
        return block;
    }

    private int CaretBlockIndex()
    {
        if (richDoc is null)
            return 0;
        var caret = richDoc.CaretBlock;
        for (var i = 0; i < richDoc.Blocks.Count; i++)
        {
            if (ReferenceEquals(richDoc.Blocks[i], caret))
                return i;
        }
        return richDoc.Blocks.Count;
    }

    private bool disposed;

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        AppTheme.Changed -= OnAppThemeChanged;
        Outline.JumpRequested -= OnJumpRequested;
        Outline.Clear(this);
        saveTimer?.Dispose();
        presenceTimer?.Dispose();
        try
        {
            await Data.LeaveAsync(NodeId);
        }
        catch (Exception)
        {
            // Teardown races the circuit's own shutdown; presence expiry covers a miss.
        }
    }
}

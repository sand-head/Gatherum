@inject IAppData Data
@inject NavigationManager Navigation

@* Maintaining the taxonomy is part of writing it: a category that cannot be renamed or
   re-nested in the UI is a category nobody fixes. *@
<div class="category-tools">
    <label>
        Name
        <input value="@name" @onchange="e => name = e.Value?.ToString() ?? name" />
    </label>
    <label>
        Nested under
        <input value="@parent" list="category-parents" placeholder="nothing — a root category"
               @onchange="e => parent = e.Value?.ToString() ?? parent" />
    </label>
    <datalist id="category-parents">
        @foreach (var candidate in others)
        {
            <option value="@candidate.Path" />
        }
    </datalist>
    <button class="primary" @onclick="SaveAsync">Save</button>
    @if (confirming)
    {
        <button class="danger" @onclick="DeleteAsync">Delete it and its subcategories</button>
        <button @onclick="() => confirming = false">Keep it</button>
    }
    else
    {
        <button @onclick="() => confirming = true">Delete…</button>
    }
    @if (error is { Length: > 0 })
    {
        <span class="text-danger">@error</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    private string name = "";
    private string parent = "";
    private string originalParent = "";
    private string? error;
    private bool confirming;
    private IReadOnlyList<CategoryInfo> others = [];

    protected override async Task OnParametersSetAsync()
    {
        name = Name;
        originalParent = Path.LastIndexOf('/') is var cut && cut >= 0 ? Path[..cut] : "";
        parent = originalParent;
        // A category cannot be nested under itself or under its own subcategory.
        var all = await Data.ListCategoriesAsync();
        others = all
            .Where(c => c.Path != Path && !c.Path.StartsWith($"{Path}/", StringComparison.Ordinal))
            .ToList();
    }

    private async Task SaveAsync()
    {
        error = null;
        var wanted = name.Trim();
        var under = parent.Trim();
        try
        {
            var path = Path;
            if (!string.Equals(wanted, Name, StringComparison.Ordinal))
            {
                await Data.RenameCategoryAsync(path, wanted);
                path = Nested(originalParent, wanted);
            }
            if (!string.Equals(under, originalParent, StringComparison.OrdinalIgnoreCase))
            {
                await Data.MoveCategoryAsync(path, under);
                path = Nested(under, wanted);
            }
            if (path != Path)
                Navigation.NavigateTo(CategoryUrl.Page(path), forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteAsync()
    {
        error = null;
        try
        {
            await Data.DeleteCategoryAsync(Path);
            Navigation.NavigateTo("/categories", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            confirming = false;
        }
    }

    /// <summary>Where a category lands after a rename or a move — the path the server
    /// will have given it, so the page can follow it there.</summary>
    private static string Nested(string parentPath, string leaf) =>
        parentPath.Trim().Length == 0
            ? leaf.Trim().ToLowerInvariant()
            : $"{parentPath.Trim().ToLowerInvariant()}/{leaf.Trim().ToLowerInvariant()}";
}

@inject IAppData Data
@implements IDisposable

@if (node?.File is { } file)
{
    var contentUrl = $"/api/files/{NodeId}/content";

    <div class="file-view">
        @if (file.SourceUrl is { } sourceUrl)
        {
            @* The bookmark's own bar: where it came from, which capture is on screen,
               and the one gesture a bookmark invites — take it again. *@
            <div class="bookmark-bar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                </svg>
                <span class="bookmark-source">Saved from
                    <a href="@sourceUrl" target="_blank" rel="noopener noreferrer">@sourceUrl</a>
                </span>
                @if (captures.Count > 1)
                {
                    <label class="capture-pick">
                        Capture
                        <select value="@ViewedCapture" @onchange="OnCaptureChosen">
                            @foreach (var capture in captures)
                            {
                                <option value="@capture.Number">
                                    @capture.UploadedAt.LocalDateTime.ToString("g")@(capture.Number == file.Version ? " — latest" : "")
                                </option>
                            }
                        </select>
                    </label>
                }
                @* Recapturing writes a new version, so it rides the Edit surface like
                   every other writing control; picking an old capture to look at is
                   reading and stays. *@
                @if (Editing)
                {
                    <button class="primary" @onclick="CaptureAgainAsync" disabled="@capturing">
                        @(capturing ? "Capturing…" : "Capture again")
                    </button>
                }
            </div>
            @if (captureError is { Length: > 0 })
            {
                <p class="capture-error" role="alert">@captureError</p>
            }
            @if (ViewedCapture != file.Version)
            {
                <p class="capture-note">An older capture, as the page stood then — the
                    History panel below can restore it, or pick the latest above.</p>
            }
        }
        <div class="file-preview">
            @if (file.MediaType.StartsWith("image/"))
            {
                <img src="@contentUrl" alt="@file.FileName" />
            }
            else if (file.MediaType == "application/pdf")
            {
                <iframe src="@contentUrl" title="@file.FileName"></iframe>
            }
            else if (file.MediaType == "text/html")
            {
                @* A bookmark's snapshot — or any saved page — reads as the page it was.
                   Doubly inert: the capture had its scripts stripped, the response is
                   served with a sandboxing policy, and the frame is sandboxed too.
                   Pinned to a version so a fresh capture shows up (the bare content URL
                   never changes) — and so the bar above can page through history. *@
                <iframe class="snapshot" src="@($"{contentUrl}?version={ViewedCapture}")"
                        title="@file.FileName" sandbox></iframe>
            }
            else if (file.MediaType == "application/epub+zip"
                || file.FileName.EndsWith(".epub", StringComparison.OrdinalIgnoreCase))
            {
                <EpubView NodeId="@NodeId" />
            }
            else if (IsRom(file))
            {
                <RomPlayer NodeId="@NodeId" FileName="@file.FileName" />
            }
            else if (file.MediaType.StartsWith("video/"))
            {
                <video src="@contentUrl" controls></video>
            }
            else if (file.MediaType.StartsWith("audio/"))
            {
                <audio src="@contentUrl" controls></audio>
            }
            else if (file.ExtractedText.Length > 0)
            {
                <pre class="file-text"><code>@file.ExtractedText</code></pre>
            }
            else
            {
                <div class="file-fallback">No inline preview for @file.MediaType.</div>
            }
        </div>

        @if (file.Analysis != "None")
        {
            <section class="file-analysis">
                <h3>What's in it</h3>
                @if (file.AnalysisPending)
                {
                    <p class="analysis-note">Being read — a transcript and a summary appear
                        here once the model has been through it.</p>
                }
                else if (file.AnalysisFailed)
                {
                    <p class="analysis-note failed">This one could not be read.
                        @file.AnalysisError</p>
                }
                else if (file.Summary.Length == 0 && file.Transcript.Length == 0)
                {
                    <p class="analysis-note">Nothing legible or audible in this one.</p>
                }
                else
                {
                    @if (file.Summary.Length > 0)
                    {
                        <p class="analysis-summary">@file.Summary</p>
                    }
                    @if (file.Transcript.Length > 0)
                    {
                        <details class="analysis-transcript" open="@(file.Summary.Length == 0)">
                            <summary>@TranscriptLabel(file.MediaType)</summary>
                            <pre>@file.Transcript</pre>
                        </details>
                    }
                }
            </section>
        }

        <dl class="file-facts">
            <dt>File</dt><dd>@file.FileName</dd>
            <dt>Type</dt><dd>@file.MediaType</dd>
            <dt>Size</dt><dd>@FormatSize(file.SizeBytes)</dd>
            <dt>SHA-256</dt><dd class="hash">@file.Sha256</dd>
            <dt></dt>
            <dd class="file-actions">
                <a class="button" href="/api/files/@NodeId/download" target="_blank">Download</a>
                @if (Editing)
                {
                    <label class="upload-label button">
                        Upload new version
                        <InputFile OnChange="UploadVersionAsync" />
                    </label>
                }
            </dd>
        </dl>

        @* The description is the file's caption when reading and a field when editing —
           the same split as everything else on the page, so a stranger on a public file
           is never offered a save the API would refuse. *@
        @if (Editing)
        {
            <section class="file-description">
                <h3>Description</h3>
                <textarea value="@description" @onchange='e => description = e.Value?.ToString() ?? ""'
                          placeholder="What is this file?"></textarea>
                <button class="primary" @onclick="SaveDescriptionAsync"
                        disabled="@(description == file.Description)">Save description</button>
            </section>
        }
        else if (file.Description.Length > 0)
        {
            <section class="file-description">
                <h3>Description</h3>
                <p>@file.Description</p>
            </section>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid NodeId { get; set; }

    /// <summary>Whether the management controls — upload, description — are out. The
    /// page decides, because ?edit is the page's concept; reading a file shows the
    /// file.</summary>
    [Parameter] public bool Editing { get; set; }

    private NodeInfo? node;
    private string description = "";
    private bool capturing;
    private string? captureError;
    private IReadOnlyList<VersionInfo> captures = [];
    private int? viewedCapture;
    private CancellationTokenSource? watching;

    /// <summary>Which capture the frame shows: a chosen one, else the latest.</summary>
    private int ViewedCapture => viewedCapture ?? node?.File?.Version ?? 0;

    private void OnCaptureChosen(ChangeEventArgs e) =>
        viewedCapture = int.TryParse(e.Value?.ToString(), out var number) ? number : null;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
        WatchAnalysis();
    }

    public void Dispose()
    {
        watching?.Cancel();
        watching?.Dispose();
    }

    private async Task ReloadAsync()
    {
        node = await Data.GetNodeAsync(NodeId);
        description = node.File?.Description ?? "";
        // A bookmark's history is its crawls; anything else's lives in the History
        // panel alone.
        captures = node.File?.SourceUrl is not null
            ? (await Data.GetVersionsAsync(NodeId)).OrderByDescending(v => v.Number).ToList()
            : [];
        if (viewedCapture is { } chosen && captures.All(c => c.Number != chosen))
            viewedCapture = null;
    }

    /// <summary>A transcript lands minutes after the upload it belongs to, on a worker
    /// this page knows nothing about. Polling while — and only while — this file is the
    /// one still pending is what lets the reader watch it arrive instead of guessing
    /// when to reload.</summary>
    private void WatchAnalysis()
    {
        watching?.Cancel();
        watching?.Dispose();
        watching = null;
        if (node?.File?.AnalysisPending is not true)
            return;

        var tokens = new CancellationTokenSource();
        watching = tokens;
        _ = PollAnalysisAsync(tokens.Token);
    }

    private async Task PollAnalysisAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(ct))
            {
                var latest = await Data.GetNodeAsync(NodeId);
                if (latest.File?.AnalysisPending is true)
                    continue;
                node = latest;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch (OperationCanceledException)
        {
            // The reader navigated away mid-transcript; nothing to report.
        }
    }

    /// <summary>A cartridge image, by what the upload said or — when a browser called
    /// it a generic pile of bytes, which most do — by what it is named. The same
    /// benefit of the doubt the reader endpoints give a book.</summary>
    private static bool IsRom(FileFacts file) =>
        file.MediaType is "application/x-nes-rom" or "application/x-gameboy-rom"
            or "application/x-gameboy-color-rom" or "application/x-sms-rom"
            or "application/x-gamegear-rom" or "application/x-gba-rom"
            or "application/x-snes-rom"
        || RomExtensions.Any(extension =>
            file.FileName.EndsWith(extension, StringComparison.OrdinalIgnoreCase));

    /// <summary>Spelled out here rather than read from `MediaTypes`, because this
    /// project deliberately does not reference Core — it reaches the server only through
    /// `IAppData`. Adding a console means adding its extension in both places.</summary>
    private static readonly string[] RomExtensions =
        [".nes", ".gb", ".gbc", ".sms", ".gg", ".gba", ".sfc", ".smc"];

    private static string TranscriptLabel(string mediaType) =>
        mediaType.StartsWith("image/") ? "Text in the image" : "Transcript";

    /// <summary>Fetches the bookmark's URL again; the capture lands as a new version,
    /// so the one being read stays in history either way.</summary>
    private async Task CaptureAgainAsync()
    {
        capturing = true;
        captureError = null;
        try
        {
            await Data.CaptureBookmarkAsync(NodeId);
            viewedCapture = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            captureError = ex.Message;
        }
        finally
        {
            capturing = false;
        }
    }

    private async Task SaveDescriptionAsync()
    {
        await Data.SetDescriptionAsync(NodeId, description);
        await ReloadAsync();
    }

    private async Task UploadVersionAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(maxAllowedSize: IAppData.MaxUploadBytes);
        await Data.UploadVersionAsync(NodeId, file.Name, file.ContentType, stream);
        await ReloadAsync();
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.##} GB",
    };
}

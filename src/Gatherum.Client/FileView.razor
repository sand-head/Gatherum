@inject IAppData Data

@if (node?.File is { } file)
{
    var contentUrl = $"/api/files/{NodeId}/content";

    <div class="file-view">
        <div class="file-preview">
            @if (file.MediaType.StartsWith("image/"))
            {
                <img src="@contentUrl" alt="@file.FileName" />
            }
            else if (file.MediaType == "application/pdf")
            {
                <iframe src="@contentUrl" title="@file.FileName"></iframe>
            }
            else if (file.MediaType.StartsWith("video/"))
            {
                <video src="@contentUrl" controls></video>
            }
            else if (file.MediaType.StartsWith("audio/"))
            {
                <audio src="@contentUrl" controls></audio>
            }
            else if (file.ExtractedText.Length > 0)
            {
                <pre class="file-text"><code>@file.ExtractedText</code></pre>
            }
            else
            {
                <div class="file-fallback">No inline preview for @file.MediaType.</div>
            }
        </div>

        <dl class="file-facts">
            <dt>File</dt><dd>@file.FileName</dd>
            <dt>Type</dt><dd>@file.MediaType</dd>
            <dt>Size</dt><dd>@FormatSize(file.SizeBytes)</dd>
            <dt>SHA-256</dt><dd class="hash">@file.Sha256</dd>
            <dt></dt>
            <dd class="file-actions">
                <a class="button" href="/api/files/@NodeId/download" target="_blank">Download</a>
                <label class="upload-label button">
                    Upload new version
                    <InputFile OnChange="UploadVersionAsync" />
                </label>
            </dd>
        </dl>

        <section class="file-description">
            <h3>Description</h3>
            <textarea value="@description" @onchange='e => description = e.Value?.ToString() ?? ""'
                      placeholder="What is this file?"></textarea>
            <button class="primary" @onclick="SaveDescriptionAsync"
                    disabled="@(description == file.Description)">Save description</button>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid NodeId { get; set; }

    private NodeInfo? node;
    private string description = "";

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        node = await Data.GetNodeAsync(NodeId);
        description = node.File?.Description ?? "";
    }

    private async Task SaveDescriptionAsync()
    {
        await Data.SetDescriptionAsync(NodeId, description);
        await ReloadAsync();
    }

    private async Task UploadVersionAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(maxAllowedSize: IAppData.MaxUploadBytes);
        await Data.UploadVersionAsync(NodeId, file.Name, file.ContentType, stream);
        await ReloadAsync();
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.##} GB",
    };
}

@inject IAppData Data
@inject IJSRuntime Js
@inject NavigationManager Navigation
@implements IAsyncDisposable
@using System.Runtime.InteropServices
@using System.Security.Cryptography
@using Gatherum.Client.Emulation
@using Gatherum.Client.Emulation.Netplay
@using SkiaSharp
@using SkiaSharp.Views.Blazor

@* A cartridge, played where it lives. The console itself is C# in this project and
   runs in the reader's own browser — the file is fetched once and nothing about the
   game goes back to the server, which is also why the player refuses to start on the
   server circuit: a frame every sixteen milliseconds over a websocket is not a game.
   The first visit downloads the WebAssembly runtime and the second one plays. *@

@if (!OperatingSystem.IsBrowser())
{
    <div class="rom-waiting">
        <p>The player runs in your browser rather than on the server, so it starts
            once the app's in-browser runtime has finished downloading — which is
            happening now. Reload the page in a moment and the cartridge boots.</p>
    </div>
}
else if (failure is { Length: > 0 })
{
    <div class="rom-waiting failed" role="alert">@failure</div>
}
else if (core is null)
{
    <div class="rom-waiting">Loading the cartridge…</div>
}
else
{
    <div class="rom-player">
        @* The picture keeps the console's own proportions; the box is only as tall as
           that makes it. *@
        <div class="rom-screen" tabindex="0" @ref="screen"
             style="aspect-ratio: @core.Width / @core.Height"
             @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" @onkeydown:preventDefault="running"
             @onblur="ReleaseAll" @onclick="FocusAsync">
            <SKCanvasView OnPaintSurface="Paint" EnableRenderLoop="running"
                          IgnorePixelScaling="true" @ref="canvas" />
            @if (!running)
            {
                <button class="rom-start" type="button" @onclick="StartAsync">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <polygon points="6 3 20 12 6 21 6 3" />
                    </svg>
                    @(started ? "Resume" : "Play")
                </button>
            }
        </div>

        @if (togetherProblem is { } trouble)
        {
            <div class="rom-together failed" role="alert">@trouble</div>
        }
        @if (session is { } play)
        {
            <div class="rom-together @(play.Fault is null ? "" : "failed")" role="status">
                @if (play.Fault is { } fault)
                {
                    <span>@fault</span>
                }
                else if (!play.Full)
                {
                    <span>Waiting for somebody else to open this page — you are player
                        @(play.Slot + 1) of @play.Capacity.</span>
                }
                else if (!together)
                {
                    <span>Handing the game over…</span>
                }
                else
                {
                    <span class="rom-seats">
                        @foreach (var seat in play.Seats.OrderBy(s => s.Slot))
                        {
                            <span class="rom-seat @(seat.Slot == play.Slot ? "you" : "")">
                                P@(seat.Slot + 1) @seat.Name
                            </span>
                        }
                    </span>
                    @if (waitingOn is { } who)
                    {
                        <span class="rom-stall">Waiting for @who…</span>
                    }
                }
            </div>
        }

        <div class="rom-controls">
            <span class="rom-system">@core.SystemName</span>
            <button type="button" class="ghost" @onclick="ToggleSound" @ref="exit">
                @(sound ? "Sound on" : "Sound off")
            </button>
            <button type="button" class="ghost" @onclick="ResetAsync">Reset</button>
            @if (core.PlayerCount > 1)
            {
                @if (session is null)
                {
                    <button type="button" class="ghost" @onclick="PlayTogetherAsync">
                        Play together
                    </button>
                }
                else
                {
                    <button type="button" class="ghost" @onclick="LeaveAndRedrawAsync">
                        Leave game
                    </button>
                }
            }
            @if (core.BatteryBacked)
            {
                <a class="button" download="@SaveFileName" href="@SaveDataUrl">Download save</a>
                <label class="upload-label button">
                    Load save
                    <InputFile OnChange="LoadSaveAsync" accept=".sav,.srm" />
                </label>
            }
        </div>

        @* The buttons a touchscreen has no keys for. Hidden where there is a mouse,
           because a pointer cannot press two of them at once and a game needs that. *@
        <div class="rom-pad">
            <div class="rom-dpad">
                <button type="button" class="up" @onpointerdown="() => Hold(GamepadButtons.Up)"
                        @onpointerup="() => Release(GamepadButtons.Up)"
                        @onpointerleave="() => Release(GamepadButtons.Up)"
                        @onpointercancel="() => Release(GamepadButtons.Up)"
                        aria-label="Up"></button>
                <button type="button" class="left" @onpointerdown="() => Hold(GamepadButtons.Left)"
                        @onpointerup="() => Release(GamepadButtons.Left)"
                        @onpointerleave="() => Release(GamepadButtons.Left)"
                        @onpointercancel="() => Release(GamepadButtons.Left)"
                        aria-label="Left"></button>
                <button type="button" class="right" @onpointerdown="() => Hold(GamepadButtons.Right)"
                        @onpointerup="() => Release(GamepadButtons.Right)"
                        @onpointerleave="() => Release(GamepadButtons.Right)"
                        @onpointercancel="() => Release(GamepadButtons.Right)"
                        aria-label="Right"></button>
                <button type="button" class="down" @onpointerdown="() => Hold(GamepadButtons.Down)"
                        @onpointerup="() => Release(GamepadButtons.Down)"
                        @onpointerleave="() => Release(GamepadButtons.Down)"
                        @onpointercancel="() => Release(GamepadButtons.Down)"
                        aria-label="Down"></button>
            </div>
            @if (core.Buttons.LeftShoulder is { } leftShoulder
                 && core.Buttons.RightShoulder is { } rightShoulder)
            {
                <div class="rom-shoulders">
                    <button type="button" @onpointerdown="() => Hold(GamepadButtons.LeftShoulder)"
                            @onpointerup="() => Release(GamepadButtons.LeftShoulder)"
                            @onpointercancel="() => Release(GamepadButtons.LeftShoulder)">@leftShoulder</button>
                    <button type="button" @onpointerdown="() => Hold(GamepadButtons.RightShoulder)"
                            @onpointerup="() => Release(GamepadButtons.RightShoulder)"
                            @onpointercancel="() => Release(GamepadButtons.RightShoulder)">@rightShoulder</button>
                </div>
            }
            @* Two face buttons sit side by side; four sit in the diamond the console
               printed them in, which is the only arrangement that makes their names
               mean anything. *@
            <div class="rom-face @(core.Buttons.X is null ? "" : "diamond")">
                @if (core.Buttons.Y is { } y)
                {
                    <button type="button" class="round y" @onpointerdown="() => Hold(GamepadButtons.Y)"
                            @onpointerup="() => Release(GamepadButtons.Y)"
                            @onpointerleave="() => Release(GamepadButtons.Y)"
                            @onpointercancel="() => Release(GamepadButtons.Y)">@y</button>
                }
                @if (core.Buttons.X is { } x)
                {
                    <button type="button" class="round x" @onpointerdown="() => Hold(GamepadButtons.X)"
                            @onpointerup="() => Release(GamepadButtons.X)"
                            @onpointerleave="() => Release(GamepadButtons.X)"
                            @onpointercancel="() => Release(GamepadButtons.X)">@x</button>
                }
                <button type="button" class="round b" @onpointerdown="() => Hold(GamepadButtons.B)"
                        @onpointerup="() => Release(GamepadButtons.B)"
                        @onpointerleave="() => Release(GamepadButtons.B)"
                        @onpointercancel="() => Release(GamepadButtons.B)">@core.Buttons.B</button>
                <button type="button" class="round a" @onpointerdown="() => Hold(GamepadButtons.A)"
                        @onpointerup="() => Release(GamepadButtons.A)"
                        @onpointerleave="() => Release(GamepadButtons.A)"
                        @onpointercancel="() => Release(GamepadButtons.A)">@core.Buttons.A</button>
            </div>
            <div class="rom-menu">
                @if (core.Buttons.Select is { } select)
                {
                    <button type="button" @onpointerdown="() => Hold(GamepadButtons.Select)"
                            @onpointerup="() => Release(GamepadButtons.Select)"
                            @onpointercancel="() => Release(GamepadButtons.Select)">@select</button>
                }
                @if (core.Buttons.Start is { } start)
                {
                    <button type="button" @onpointerdown="() => Hold(GamepadButtons.Start)"
                            @onpointerup="() => Release(GamepadButtons.Start)"
                            @onpointercancel="() => Release(GamepadButtons.Start)">@start</button>
                }
            </div>
        </div>

        <p class="rom-keys">Arrow keys move, <kbd>Z</kbd> and <kbd>X</kbd> are
            @core.Buttons.B and @core.Buttons.A@if (core.Buttons.Start is { } startKey)
            {
                <text>, <kbd>Enter</kbd> is @startKey</text>
            }@if (core.Buttons.Select is { } selectKey)
            {
                <text> and <kbd>Shift</kbd> is @selectKey</text>
            }@if (core.Buttons.Y is { } yKey && core.Buttons.X is { } xKey)
            {
                <text>; <kbd>A</kbd> and <kbd>S</kbd>, above them, are @yKey and @xKey</text>
            }@if (core.Buttons.LeftShoulder is { } leftKey
                  && core.Buttons.RightShoulder is { } rightKey)
            {
                <text>; <kbd>Q</kbd> and <kbd>E</kbd> are @leftKey and @rightKey</text>
            }.
            A plugged-in or paired controller works too — its buttons count by where
            they sit on the pad, not by what is printed on them.
            @if (core.BatteryBacked)
            {
                <text>This cartridge saves, and its save is kept in this browser —
                    download it to take it anywhere else.</text>
            }
        </p>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid NodeId { get; set; }
    [Parameter, EditorRequired] public string FileName { get; set; } = "";

    private IEmulatorCore? core;
    private Guid loaded;

    /// <summary>The cartridge whose save has been put back and whose first frame has
    /// been painted, so that work happens once per cartridge rather than once ever.</summary>
    private Guid restored;
    private string? failure;
    private bool running, started, sound = true;

    private ElementReference screen;
    private ElementReference exit;
    private SKCanvasView? canvas;
    private IJSObjectReference? module;

    /// <summary>The same module, when the runtime is the browser's own and a call can
    /// be made without a task to await it. Sound is pushed once a frame, and sixty
    /// awaited round trips a second is sixty allocations this does not need.</summary>
    private IJSInProcessObjectReference? directModule;

    private SKBitmap? picture;
    private GCHandle pinnedFrame;

    private GamepadButtons pressed;

    /// <summary>What a real controller is holding down, polled once per painted frame.
    /// Kept apart from <see cref="pressed"/> because keys arrive as events and a
    /// controller is read as state — and a controller needs no focus, so focus leaving
    /// the screen releases the keys and not these.</summary>
    private GamepadButtons padHeld;

    /// <summary>Where that controller's sticks are leaning, for the console that steers
    /// with one. Solo only — see the note in <see cref="PollGamepad"/>.</summary>
    private StickState padSticks;

    /// <summary>Everything held right now, whichever hardware is holding it. The one
    /// value the console — and, playing together, the wire — ever sees.</summary>
    private GamepadButtons Held => pressed | padHeld;

    private readonly System.Diagnostics.Stopwatch clock = new();
    private double owed;

    // ---- playing together ---------------------------------------------------
    private NetplaySession? session;
    private string romHash = "";

    /// <summary>Which frame the shared game is on. Counted whether or not anybody else
    /// is here, so that the moment somebody arrives there is a number to hand them.</summary>
    private int netFrame;

    /// <summary>Whether the two machines are actually running in step yet — false while
    /// a room is filling, and while a joiner is waiting for the host's machine.</summary>
    private bool together;
    private string? waitingOn;
    private string? togetherProblem;
    private readonly GamepadButtons[] slotInputs = new GamepadButtons[PlayProtocol.MaxPlayers];
    private byte[] stateBuffer = [];

    private readonly short[] samples = new short[2048];
    private readonly byte[] sampleBytes = new byte[4096];

    /// <summary>What the cartridge's battery memory held when it was last written out,
    /// so the download link has something to point at without re-reading it every
    /// render.</summary>
    private string savedData = "";
    private DateTime saveDue = DateTime.MaxValue;

    private string SaveFileName =>
        Path.GetFileNameWithoutExtension(FileName) + ".sav";

    private string SaveDataUrl => "data:application/octet-stream;base64," + savedData;

    /// <summary>Where the file's bytes are served from, for a core that fetches its own
    /// disc. The same address the file view hands a browser for a picture or a video.</summary>
    private string ContentUrl => $"/api/files/{NodeId}/content";

    private const string NoCoreMessage =
        "This Gatherum was built without a core for this machine, so the " +
        "cartridge can be downloaded but not played.";

    protected override async Task OnParametersSetAsync()
    {
        if (loaded == NodeId || !OperatingSystem.IsBrowser())
            return;
        // Another cartridge on the same component: put the last one's save away and
        // let go of the frame it pinned before anything else.
        await FlushSaveAsync();
        Unload();
        loaded = NodeId;
        running = false;
        started = false;
        failure = null;
        savedData = "";
        try
        {
            // The head first, because a disc is gigabytes and its header is in the first
            // kilobyte: a disc never comes through this heap at all, and only a cartridge
            // is fetched whole.
            var head = await Data.ReadHeadAsync(NodeId, Emulator.HeadBytes);
            if (Emulator.Identify(head, FileName) is { } discKind && Emulator.IsDisc(discKind))
            {
                if (!VendoredCore.Handles(discKind))
                    Emulator.Load(head, FileName);
                // Nobody plays a disc together, so there is nothing for a room to compare.
                romHash = "";
                module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/gatherum.js");
                directModule = module as IJSInProcessObjectReference;
                core = await VendoredCore.CreateAsync(module, discKind, [], ContentUrl)
                    ?? throw new NotSupportedException(NoCoreMessage);
            }
            else if (Emulator.NamedLikeADisc(FileName))
            {
                throw new NotSupportedException(
                    "This is named like a disc image but does not carry a GameCube " +
                    "disc's header, so it is not fetched whole.");
            }
            else
            {
                var rom = await Data.ReadBytesAsync(NodeId);
                // The same spelling the server stores, so a room can refuse two people
                // who are not holding the same cartridge.
                romHash = Convert.ToHexStringLower(SHA256.HashData(rom));
                if (Emulator.Identify(rom, FileName) is { } kind && VendoredCore.Handles(kind))
                {
                    // A core from elsewhere is fetched and instantiated rather than
                    // constructed, so the module has to be in hand before the first render.
                    module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/gatherum.js");
                    directModule = module as IJSInProcessObjectReference;
                    core = await VendoredCore.CreateAsync(module, kind, rom)
                        ?? throw new NotSupportedException(NoCoreMessage);
                }
                else
                {
                    core = Emulator.Load(rom, FileName);
                }
            }
            stateBuffer = new byte[core.SaveStateSize];
            pinnedFrame = GCHandle.Alloc(core.Frame, GCHandleType.Pinned);
            picture = new SKBitmap();
            picture.InstallPixels(
                new SKImageInfo(core.Width, core.Height, SKColorType.Bgra8888,
                    SKAlphaType.Opaque),
                pinnedFrame.AddrOfPinnedObject());
        }
        catch (NotSupportedException problem)
        {
            failure = problem.Message;
        }
        catch (Exception problem)
        {
            failure = $"This cartridge would not load: {problem.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Once per cartridge, not once per component: a second cartridge loaded into the
        // same player has its own save to put back and its own first frame to paint.
        if (core is null || restored == loaded)
            return;
        restored = loaded;
        module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/gatherum.js");
        directModule = module as IJSInProcessObjectReference;
        if (core.BatteryBacked)
        {
            var stored = await module.InvokeAsync<string?>("readEmulatorSave", NodeId);
            if (stored is { Length: > 0 })
            {
                core.LoadSaveRam(Convert.FromBase64String(stored));
                savedData = stored;
            }
        }
        // The first frame is painted before anything runs, so the screen shows the
        // console's own blank rather than an empty box behind the play button.
        canvas?.Invalidate();
    }

    private async Task StartAsync()
    {
        if (core is null)
            return;
        running = true;
        started = true;
        owed = 0;
        clock.Restart();
        if (sound && module is not null)
            await module.InvokeVoidAsync("startEmulatorAudio", core.SampleRate);
        // Keys only reach a focused element, and the click that started the game is
        // the gesture that is allowed to move focus.
        await screen.FocusAsync();
    }

    /// <summary>Focus leaving the screen means the key-up that would have released a
    /// button will never arrive, so every key is let go at once — otherwise tabbing
    /// away mid-jump leaves the character running into a wall. A controller keeps what
    /// it holds: it is re-read every frame, so it cannot stick the way a key can.</summary>
    private void ReleaseAll()
    {
        pressed = GamepadButtons.None;
        core?.SetButtons(0, Held);
    }

    private async Task FocusAsync()
    {
        if (running)
            await screen.FocusAsync();
    }

    private async Task StopSoundAsync()
    {
        if (module is null)
            return;
        try
        {
            await module.InvokeVoidAsync("stopEmulatorAudio");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleSound()
    {
        sound = !sound;
        if (module is null || core is null)
            return;
        if (sound && running)
            await module.InvokeVoidAsync("startEmulatorAudio", core.SampleRate);
        else
            await StopSoundAsync();
    }

    private async Task ResetAsync()
    {
        core?.Reset();
        await FlushSaveAsync();
        canvas?.Invalidate();
    }

    /// <summary>Runs whatever frames the wall clock says are due and paints the last
    /// one. The browser calls this once a display refresh, which is 60 times a second
    /// on most screens and 120 on some — neither of which is either console's frame
    /// rate, so the clock decides and the display only asks.</summary>
    private void Paint(SKPaintSurfaceEventArgs e)
    {
        if (core is not null && running)
        {
            PollGamepad();
            var frame = 1.0 / core.FramesPerSecond;
            owed += clock.Elapsed.TotalSeconds;
            clock.Restart();
            // A tab that was in the background for a minute owes a minute of frames,
            // which is not a debt worth paying: catching up is what makes a game
            // sprint through a cutscene on the way back.
            if (owed > frame * 4)
                owed = frame;
            OpenTheGate();
            var ran = 0;
            while (owed >= frame && ran < 2)
            {
                if (!Advance())
                    break;
                owed -= frame;
                ran++;
            }
            if (ran > 0)
                PushSound();
            WatchSave();
        }

        var canvasSurface = e.Surface.Canvas;
        canvasSurface.Clear(SKColors.Black);
        if (picture is null || core is null)
            return;

        // Whole pixels, centred: a console's picture upscaled with any smoothing at
        // all stops looking like the thing it is.
        var scale = Math.Min((float)e.Info.Width / core.Width, (float)e.Info.Height / core.Height);
        var width = core.Width * scale;
        var height = core.Height * scale;
        var destination = SKRect.Create((e.Info.Width - width) / 2,
            (e.Info.Height - height) / 2, width, height);
        canvasSurface.DrawBitmap(picture, destination,
            new SKSamplingOptions(SKFilterMode.Nearest, SKMipmapMode.None));
    }

    /// <summary>One frame, alone or together.</summary>
    private bool Advance()
    {
        if (core is null)
            return false;
        if (session is null || !together)
        {
            // Solo, or in a room still filling. A joiner waiting for the host's machine
            // must not run: whatever it did would be a game the host never played.
            if (session is { Connected: true, Full: true, IsHost: false })
                return false;
            core.RunFrame();
            netFrame++;
            return true;
        }
        return AdvanceTogether();
    }

    /// <summary>A frame runs only when everybody's buttons for it are in hand. That is
    /// the whole of the synchronisation: two deterministic machines given the same input
    /// on the same frame stay the same machine.</summary>
    private bool AdvanceTogether()
    {
        var play = session!;
        play.SendInput(netFrame + PlayProtocol.InputDelay, Held);
        if (!play.TryCollect(netFrame, slotInputs))
        {
            Stalled(play.WaitingFor(netFrame));
            return false;
        }

        Stalled(null);
        for (var slot = 0; slot < core!.PlayerCount; slot++)
            core.SetButtons(slot, slot < play.Capacity ? slotInputs[slot] : GamepadButtons.None);
        core.RunFrame();
        netFrame++;

        if (netFrame % PlayProtocol.ChecksumInterval != 0)
            return true;

        // Compare notes: this frame's fingerprint goes out, and the one from a second
        // ago — long enough for everybody's to have arrived — is checked.
        if (core.SaveState(stateBuffer))
            play.SendChecksum(netFrame, PlayProtocol.Fingerprint(stateBuffer));
        if (play.HasDiverged(netFrame - PlayProtocol.ChecksumInterval))
        {
            together = false;
            return false;
        }
        play.Forget(netFrame - 2 * PlayProtocol.ChecksumInterval);
        return true;
    }

    /// <summary>The painting loop runs outside the render tree, so a stall only reaches
    /// the screen if it asks — and only when it changes, because this is called sixty
    /// times a second.</summary>
    private void Stalled(string? who)
    {
        if (waitingOn == who)
            return;
        waitingOn = who;
        StateHasChanged();
    }

    /// <summary>Runs at the top of each painted frame: starts the shared game once the
    /// room is full, which for the host means handing over its machine and for everybody
    /// else means putting it on.</summary>
    private void OpenTheGate()
    {
        // A partner who closed their tab is never going to send frame N's buttons, so
        // the game drops back to one player rather than waiting for them all evening.
        if (together && session is not { Connected: true, Full: true })
        {
            together = false;
            waitingOn = null;
            StateHasChanged();
            return;
        }

        if (session is not { Connected: true, Full: true } play || together || core is null)
            return;

        if (play.IsHost)
        {
            if (!core.SaveState(stateBuffer))
                return;
            play.SendState(netFrame, stateBuffer);
        }
        else
        {
            if (play.TakeArrivingState() is not { } arriving)
                return;
            if (!core.LoadState(arriving.Machine))
                return;
            netFrame = arriving.Frame;
        }

        // Nobody has committed buttons for the frames already inside the delay window,
        // and both machines have to agree about them — so both fill them with nothing.
        for (var frame = netFrame; frame < netFrame + PlayProtocol.InputDelay; frame++)
            play.SendInput(frame, GamepadButtons.None);
        together = true;
        StateHasChanged();
    }

    private async Task PlayTogetherAsync()
    {
        if (core is null || session is not null)
            return;
        var address = Navigation.ToAbsoluteUri($"/api/nodes/{NodeId}/play");
        var endpoint = new UriBuilder(address)
        {
            Scheme = address.Scheme == Uri.UriSchemeHttps ? "wss" : "ws",
        }.Uri;
        try
        {
            session = await NetplaySession.ConnectAsync(endpoint, romHash, core.PlayerCount);
            session.Changed += OnSessionChanged;
        }
        catch (Exception problem)
        {
            // The cartridge still plays on its own; only the invitation failed.
            togetherProblem = $"This game could not be opened up: {problem.Message}";
        }
        StateHasChanged();
    }

    private async Task LeaveTogetherAsync()
    {
        var play = session;
        session = null;
        together = false;
        waitingOn = null;
        togetherProblem = null;
        if (play is null)
            return;
        play.Changed -= OnSessionChanged;
        await play.DisposeAsync();
    }

    private async Task LeaveAndRedrawAsync()
    {
        await LeaveTogetherAsync();
        StateHasChanged();
    }

    private void OnSessionChanged()
    {
        if (session?.Fault is not null)
            together = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void PushSound()
    {
        if (!sound || core is null || module is null)
            return;
        var count = core.ReadAudio(samples);
        if (count == 0)
            return;
        // The buffer goes over whole and the count says how much of it is real, so
        // there is no per-frame array to allocate and collect.
        Buffer.BlockCopy(samples, 0, sampleBytes, 0, count * 2);
        if (directModule is not null)
            directModule.InvokeVoid("queueEmulatorAudio", sampleBytes, count, core.AudioChannels);
        else
            _ = module.InvokeVoidAsync("queueEmulatorAudio", sampleBytes, count, core.AudioChannels);
    }

    /// <summary>A save is written a couple of seconds after the game first touches its
    /// battery memory, not on every write: a game that keeps a running checksum there
    /// would otherwise have this writing to storage several times a frame. The two
    /// seconds are counted from the first write of a burst rather than the last, so a
    /// game that never stops writing still gets saved.</summary>
    private void WatchSave()
    {
        if (core is null || !core.BatteryBacked)
            return;
        if (core.SaveDirty)
        {
            core.MarkSaved();
            if (saveDue == DateTime.MaxValue)
                saveDue = DateTime.UtcNow.AddSeconds(2);
        }
        if (saveDue == DateTime.MaxValue || DateTime.UtcNow < saveDue)
            return;
        saveDue = DateTime.MaxValue;
        _ = FlushSaveAsync();
    }

    private async Task FlushSaveAsync()
    {
        if (core is null || !core.BatteryBacked || module is null)
            return;
        savedData = Convert.ToBase64String(core.SaveRam());
        core.MarkSaved();
        saveDue = DateTime.MaxValue;
        try
        {
            await module.InvokeVoidAsync("writeEmulatorSave", NodeId, savedData);
        }
        catch (JSDisconnectedException)
        {
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSaveAsync(InputFileChangeEventArgs e)
    {
        if (core is null)
            return;
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 1024 * 1024);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        core.LoadSaveRam(buffer.ToArray());
        core.Reset();
        await FlushSaveAsync();
        canvas?.Invalidate();
    }

    private void Hold(GamepadButtons button)
    {
        pressed |= button;
        core?.SetButtons(0, Held);
    }

    private void Release(GamepadButtons button)
    {
        pressed &= ~button;
        core?.SetButtons(0, Held);
    }

    /// <summary>The Gamepad API is polled, not evented, so the player asks once per
    /// painted frame — synchronously, because the game only ever runs where the runtime
    /// is the browser's own, and sixty awaited round trips a second buy nothing. A
    /// controller feeds the same bits a keyboard does, so the console — and anybody
    /// playing along over the wire — never knows which was held.</summary>
    private void PollGamepad()
    {
        if (directModule is null)
            return;
        var now = MapPad(directModule.Invoke<int>("readEmulatorGamepad"));
        if (now != padHeld)
        {
            padHeld = now;
            core?.SetButtons(0, Held);
        }

        // The sticks stay out of a shared game on purpose: playing together exchanges
        // buttons and nothing else, so an analog lean the wire never carried would be a
        // frame the other machine never played. The one console with a stick seats one
        // player; a stick console that plays together puts its sticks on the wire first.
        if (session is not null)
            return;
        var sticks = StickState.Unpack(directModule.Invoke<int>("readEmulatorGamepadSticks"));
        if (sticks == padSticks)
            return;
        padSticks = sticks;
        core?.SetSticks(0, sticks);
    }

    /// <summary>The W3C standard gamepad layout, folded onto the console's bits by
    /// position rather than printing: the bottom face button is B and the right one A,
    /// because that is where every machine here put that pair — whatever a modern pad
    /// prints on them — and the left and top land on Y and X the way the one diamond
    /// pad printed its. Both shoulder rows reach the one pair these consoles had, so a
    /// trigger works where a pad has them.</summary>
    private static GamepadButtons MapPad(int held)
    {
        var buttons = GamepadButtons.None;
        if ((held & 0x0001) != 0) buttons |= GamepadButtons.B;             // bottom face
        if ((held & 0x0002) != 0) buttons |= GamepadButtons.A;             // right face
        if ((held & 0x0004) != 0) buttons |= GamepadButtons.Y;             // left face
        if ((held & 0x0008) != 0) buttons |= GamepadButtons.X;             // top face
        if ((held & 0x0050) != 0) buttons |= GamepadButtons.LeftShoulder;  // L1, L2
        if ((held & 0x00A0) != 0) buttons |= GamepadButtons.RightShoulder; // R1, R2
        if ((held & 0x0100) != 0) buttons |= GamepadButtons.Select;
        if ((held & 0x0200) != 0) buttons |= GamepadButtons.Start;
        if ((held & 0x1000) != 0) buttons |= GamepadButtons.Up;
        if ((held & 0x2000) != 0) buttons |= GamepadButtons.Down;
        if ((held & 0x4000) != 0) buttons |= GamepadButtons.Left;
        if ((held & 0x8000) != 0) buttons |= GamepadButtons.Right;
        return buttons;
    }

    /// <summary>Keys are swallowed while the game is running — the arrow keys would
    /// scroll the page out from under it otherwise — so Escape is the way back out to
    /// the rest of the page for anyone using a keyboard.</summary>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ReleaseAll();
            await exit.FocusAsync();
            return;
        }
        if (Map(e.Key) is { } button)
            Hold(button);
    }

    private void OnKeyUp(KeyboardEventArgs e)
    {
        if (Map(e.Key) is { } button)
            Release(button);
    }

    /// <summary>One mapping for every console, because the bits are the same on all of
    /// them and only the printing differs. Z and X sit where a right hand rests on a
    /// keyboard, in the order the two face buttons sit on every machine here; A and S sit
    /// above and left of them, which is where Y and X sit relative to B and A on the one
    /// pad that has four. A core simply never reads the bits its hardware never had.</summary>
    private static GamepadButtons? Map(string key) => key switch
    {
        "ArrowUp" => GamepadButtons.Up,
        "ArrowDown" => GamepadButtons.Down,
        "ArrowLeft" => GamepadButtons.Left,
        "ArrowRight" => GamepadButtons.Right,
        "z" or "Z" => GamepadButtons.B,
        "x" or "X" => GamepadButtons.A,
        "a" or "A" => GamepadButtons.Y,
        "s" or "S" => GamepadButtons.X,
        "Enter" => GamepadButtons.Start,
        "Shift" => GamepadButtons.Select,
        "q" or "Q" => GamepadButtons.LeftShoulder,
        "e" or "E" => GamepadButtons.RightShoulder,
        _ => null,
    };

    /// <summary>Lets go of the bitmap and the pin under it. The frame buffer is pinned
    /// for as long as a cartridge is loaded, so it has to be released when one is
    /// swapped out as well as when the page closes.</summary>
    private void Unload()
    {
        picture?.Dispose();
        picture = null;
        if (pinnedFrame.IsAllocated)
            pinnedFrame.Free();
        // A vendored core holds a cartridge inside its own WebAssembly heap and pins
        // arrays on this side; letting go of the reference would leak both.
        (core as IDisposable)?.Dispose();
        core = null;
        restored = Guid.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        running = false;
        await LeaveTogetherAsync();
        await FlushSaveAsync();
        await StopSoundAsync();
        Unload();
        if (module is null)
            return;
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}

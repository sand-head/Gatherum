@inject IAppData Data

<section class="settings-keys">
    <h2>API keys</h2>
    <p>
        Keys authenticate the REST API (<code>/api</code>) and the MCP server
        (<code>/mcp</code>) as you. Send them as <code>Authorization: Bearer …</code>.
    </p>

    <form class="key-create" @onsubmit="CreateAsync">
        <input placeholder="Key name (e.g. claude-code)" @bind="newKeyName" @bind:event="oninput" />
        <button class="primary" type="submit" disabled="@(newKeyName.Trim().Length == 0)">
            Create key
        </button>
    </form>

    @if (freshToken is not null)
    {
        <div class="fresh-token">
            <p>Copy this token now — it won't be shown again:</p>
            <code>@freshToken</code>
        </div>
    }

    @* The roles are redundant while this is a table and load-bearing once it is
       not: below the compact breakpoint the rows become cards, and display:
       block on a table element drops its implicit role. data-label carries the
       column head down into the card, where the thead is gone. *@
    <table class="key-table stacked-table" role="table">
        <thead role="rowgroup">
            <tr role="row"><th>Name</th><th>Key</th><th>Created</th><th>Last used</th><th></th></tr>
        </thead>
        <tbody role="rowgroup">
            @foreach (var key in keys)
            {
                <tr role="row" class="@(key.IsActive ? "" : "revoked")">
                    <td role="cell" data-label="Name">@key.Name</td>
                    <td role="cell" data-label="Key"><code>@key.Prefix…</code></td>
                    <td role="cell" data-label="Created">@key.CreatedAt.LocalDateTime.ToString("d")</td>
                    <td role="cell" data-label="Last used">@(key.LastUsedAt?.LocalDateTime.ToString("g") ?? "never")</td>
                    <td role="cell">
                        @if (key.IsActive)
                        {
                            <button class="danger" @onclick="() => RevokeAsync(key.Id)">Revoke</button>
                        }
                        else
                        {
                            <span>revoked</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private IReadOnlyList<KeyInfo> keys = [];
    private string newKeyName = "";
    private string? freshToken;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => keys = await Data.ListKeysAsync();

    private async Task CreateAsync()
    {
        if (newKeyName.Trim().Length == 0)
            return;
        var created = await Data.CreateKeyAsync(newKeyName.Trim());
        freshToken = created.Token;
        newKeyName = "";
        await ReloadAsync();
    }

    private async Task RevokeAsync(Guid id)
    {
        await Data.RevokeKeyAsync(id);
        await ReloadAsync();
    }
}

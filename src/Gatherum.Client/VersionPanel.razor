@using SlopEdit.Blazor
@using SlopEdit.Core.Rich
@implements IDisposable
@inject IAppData Data
@inject NavigationManager Navigation
@inject ThemeState AppTheme

<section class="version-panel">
    <button class="ghost" @onclick="ToggleAsync">
        @(open ? "Hide history" : $"History")
    </button>
    @if (open)
    {
        <table>
            <tbody>
                @foreach (var version in versions)
                {
                    <tr class="@(previewing == version.Number ? "selected" : "")">
                        <td>#@version.Number</td>
                        <td>@version.FileName</td>
                        <td>@FormatSize(version.SizeBytes)</td>
                        <td><time>@version.UploadedAt.LocalDateTime.ToString("g")</time></td>
                        <td>
                            @if (version.IsText)
                            {
                                <button class="ghost" @onclick="() => PreviewAsync(version)">view</button>
                            }
                            <a href="/api/files/@NodeId/download?version=@version.Number">download</a>
                            @if (version.Number != versions.Max(v => v.Number))
                            {
                                <button class="ghost restore"
                                        @onclick="() => RestoreAsync(version.Number)">restore</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (previewDoc is not null)
        {
            <div class="history-preview document-surface">
                <DocumentView Grid="previewDoc" ReadOnly="true" ImageSource="Data.GetImageAsync"
                              Theme="EditorThemes.For(AppTheme.IsDark)"
                              AriaLabel="Version preview" />
            </div>
        }
        else if (previewText is not null)
        {
            <pre class="history-preview"><code>@previewText</code></pre>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid NodeId { get; set; }

    private bool open;
    private IReadOnlyList<VersionInfo> versions = [];
    private int? previewing;
    private RichDocument? previewDoc;
    private string? previewText;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await AppTheme.EnsureWatchingAsync();
            AppTheme.Changed += OnAppThemeChanged;
        }
    }

    private void OnAppThemeChanged() => _ = InvokeAsync(() =>
    {
        if (previewDoc is not null)
            GatherumMarkdown.Dress(previewDoc, AppTheme.IsDark);
        StateHasChanged();
    });

    public void Dispose() => AppTheme.Changed -= OnAppThemeChanged;

    private async Task ToggleAsync()
    {
        open = !open;
        previewing = null;
        previewDoc = null;
        previewText = null;
        if (open)
            versions = await Data.GetVersionsAsync(NodeId);
    }

    private async Task PreviewAsync(VersionInfo version)
    {
        previewing = version.Number;
        var text = await Data.GetVersionTextAsync(NodeId, version.Number);
        if (version.MediaType == "text/markdown")
        {
            // The same dialect the editor reads, so an old version previews with the
            // infoboxes and callouts it was written with.
            previewDoc = GatherumMarkdown.Parse(text, AppTheme.IsDark);
            previewText = null;
        }
        else
        {
            previewText = text;
            previewDoc = null;
        }
    }

    private async Task RestoreAsync(int number)
    {
        await Data.RestoreVersionAsync(NodeId, number);
        // The editor lives in another island; a full reload re-seeds it.
        Navigation.Refresh(forceReload: true);
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.##} GB",
    };
}

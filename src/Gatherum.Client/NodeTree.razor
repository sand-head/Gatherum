@implements IDisposable
@inject IAppData Data
@inject TreeState Tree
@inject NavigationManager Navigation
@inject IJSRuntime Js

<div class="tree" @ref="dropZone">
    @foreach (var root in Tree.ByParent[null])
    {
        <TreeItem Node="root" Depth="0" Tree="this" />
    }
</div>

@if (moving is { } movingNode)
{
    <Modal Title="@($"Move “{movingNode.Title}”")" OnClose="() => moving = null">
        <label>New parent</label>
        <select @bind="moveTargetId">
            <option value="">(top level)</option>
            @foreach (var (candidate, depth) in Flatten())
            {
                @if (candidate.Id != movingNode.Id && !IsInSubtree(candidate.Id, movingNode.Id))
                {
                    <option value="@candidate.Id">@(new string(' ', depth * 3))@candidate.Title</option>
                }
            }
        </select>
        <div class="modal-actions">
            <button class="primary" @onclick="ConfirmMoveAsync">Move</button>
            <button @onclick="() => moving = null">Cancel</button>
        </div>
    </Modal>
}

@code {
    private ElementReference dropZone;
    private TreeNodeInfo? moving;
    private string moveTargetId = "";
    private readonly HashSet<Guid> expanded = [];
    private IJSObjectReference? module;

    protected override async Task OnInitializedAsync()
    {
        Tree.Changed += OnTreeChanged;
        await Tree.RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/gatherum.js");
            await module.InvokeVoidAsync("initDropZone", dropZone,
                DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task OnFilesDropped() => await Tree.RefreshAsync();

    public bool IsExpanded(Guid id) => expanded.Contains(id);

    public void Toggle(Guid id)
    {
        if (!expanded.Remove(id))
            expanded.Add(id);
    }

    public async Task CreatePageAsync(Guid? parentId)
    {
        var nodeId = await Data.CreatePageAsync(parentId, "Untitled");
        if (parentId is { } id)
            expanded.Add(id);
        await Tree.RefreshAsync();
        Navigation.NavigateTo($"/nodes/{nodeId}");
    }

    public async Task UploadAsync(InputFileChangeEventArgs e, Guid? parentId)
    {
        Guid lastId = default;
        foreach (var file in e.GetMultipleFiles())
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: IAppData.MaxUploadBytes);
            lastId = await Data.UploadFileAsync(parentId, file.Name, file.ContentType, stream);
        }
        if (parentId is { } id)
            expanded.Add(id);
        await Tree.RefreshAsync();
        if (lastId != default)
            Navigation.NavigateTo($"/nodes/{lastId}");
    }

    public async Task MoveBy(TreeNodeInfo node, int delta)
    {
        var position = Math.Max(0, node.Position + delta);
        await Data.MoveAsync(node.Id, node.ParentId, position);
        await Tree.RefreshAsync();
    }

    public void BeginMove(TreeNodeInfo node)
    {
        moving = node;
        moveTargetId = "";
    }

    private async Task ConfirmMoveAsync()
    {
        if (moving is null)
            return;
        Guid? target = Guid.TryParse(moveTargetId, out var id) ? id : null;
        await Data.MoveAsync(moving.Id, target);
        moving = null;
        await Tree.RefreshAsync();
    }

    public async Task DeleteAsync(TreeNodeInfo node)
    {
        await Data.DeleteAsync(node.Id);
        await Tree.RefreshAsync();
        Navigation.NavigateTo("/");
    }

    public async Task TogglePublicAsync(TreeNodeInfo node)
    {
        await Data.SetAccessAsync(node.Id, node.IsPublic ? "Private" : "Public");
        await Tree.RefreshAsync();
    }

    private IEnumerable<(TreeNodeInfo Node, int Depth)> Flatten(Guid? parentId = null, int depth = 0)
    {
        foreach (var node in Tree.ByParent[parentId])
        {
            yield return (node, depth);
            foreach (var child in Flatten(node.Id, depth + 1))
                yield return child;
        }
    }

    private bool IsInSubtree(Guid candidate, Guid root)
    {
        var byId = Tree.Nodes.ToDictionary(n => n.Id, n => n.ParentId);
        for (Guid? current = candidate; current is { } id; current = byId.GetValueOrDefault(id))
        {
            if (id == root)
                return true;
        }
        return false;
    }

    private void OnTreeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Tree.Changed -= OnTreeChanged;
}

@inject IAppData Data
@inject TreeState Tree

<header class="node-header">
    @* Every route needs an h1: Routes.razor's FocusOnNavigate looks for one, and a
       node page had none at all — the title is a field, because editing it in place
       is the point. So the h1 wraps the field rather than repeating its words. *@
    <h1 class="node-title">
        <input class="node-title-input" value="@title" aria-label="Page title"
               @onchange="e => RenameAsync(e.Value?.ToString() ?? title)" />
    </h1>
    @* What a page is about now sits at the foot of the article, where a wiki keeps
       it, so this band is down to who can reach the page. It is nothing at all for
       a visitor reading somebody's unlisted link, and empty rows are not a design. *@
    @if (Owned || Access != "Private")
    {
        <div class="node-meta">
            @* Only the owner can change who reaches a node, so only the owner is offered the
               control — the service would refuse anybody else, and a button that always fails
               is worse than no button. *@
            @if (Owned)
            {
                <ShareControl NodeId="@NodeId" Title="@Title" OnChanged="OnAccessChanged" />
            }
            @if (Access == "Public")
            {
                <span class="badge badge-public" title="Anyone on the internet can read this">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
                    </svg>
                    Public
                </span>
            }
            else if (Access == "Shared")
            {
                <span class="badge badge-shared" title="Shared with someone">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    </svg>
                    Shared
                </span>
            }
        </div>
    }
    @* A wiki's page actions: beside the title where there is room for words, and
       in their own band under the metadata where there is not — which is where
       Wikipedia's mobile skin keeps them, as an icon, just above the rule that
       opens the article. *@
    @if (EditHref is not null)
    {
        <nav class="node-tabs" aria-label="Page actions">
            <a class="button node-tab" href="@EditHref" title="Edit" aria-label="Edit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                </svg>
                <span class="label">Edit</span>
            </a>
        </nav>
    }
</header>

@code {
    [Parameter, EditorRequired] public Guid NodeId { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>"Private", "Shared" or "Public". Private is the default and wears no
    /// badge; the two exceptions do.</summary>
    [Parameter] public string Access { get; set; } = "Private";

    /// <summary>Whether the viewer owns this node. Ownership is the path, so it is the
    /// server's answer rather than anything this component can work out.</summary>
    [Parameter] public bool Owned { get; set; }

    /// <summary>Naming the first person moves a node from Private to Shared, so the page
    /// re-reads it rather than leaving a stale badge.</summary>
    [Parameter] public EventCallback OnAccessChanged { get; set; }

    /// <summary>Where the Edit tab goes, or null for a node that has no editable
    /// body and for the editor itself — the page decides, because only it knows
    /// which surface is showing.</summary>
    [Parameter] public string? EditHref { get; set; }

    private string title = "";

    protected override void OnParametersSet() => title = Title;

    private async Task RenameAsync(string newTitle)
    {
        if (newTitle.Length == 0 || newTitle == title)
            return;
        await Data.RenameAsync(NodeId, newTitle);
        title = newTitle;
        await Tree.RefreshAsync();
    }
}
